k"}]],["long","/lɒŋ/","ADJ","uzyn","длинный","measuring a lot from end to end","a long journey.","uzyn ýol","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["short","/ʃɔːt/","ADJ","gysga, kiçi boýly","короткий","not long, or not tall","a short film.","gysga film","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["rich","/rɪtʃ/","ADJ","baý","богатый","having a lot of money","a rich family.","baý maşgala","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["poor","/pʊə/","ADJ","garyp","бедный","having little money","a poor village.","garyp oba","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["right","/raɪt/","ADJ","dogry","правильный","correct, not wrong","the right answer.","dogry jogap","A1","Oxford 3000","—","the right answer","New",[{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["wrong","/rɒŋ/","ADJ","ýalňyş","неправильный","not correct","the wrong bus.","ýalňyş awtobus","A1","Oxford 3000","—","the wrong bus","New",[{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["safe","/seɪf/","ADJ","howpsuz","безопасный","not dangerous","The city is safe at night.","Şäher gije howpsuz.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"},{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"}]],["dangerous","/ˈdeɪndʒərəs/","ADJ","howply","опасный","able to hurt you","a dangerous road.","howply ýol","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"},{"book":"int","unit":9,"lesson":"9A","page":86,"section":"vocabulary"}]],["strong","/strɒŋ/","ADJ","güýçli","сильный","having a lot of power","a strong wind.","güýçli şemal","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["weak","/wiːk/","ADJ","gowşak","слабый","not strong","weak coffee.","gowşak kofe","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["tall","/tɔːl/","ADJ","uzyn boýly","высокий (о росте)","having a lot of height","a tall man.","uzyn boýly adam","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"},{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["the same","/ðə seɪm/","ADJ","meňzeş, şol bir","такой же","not different","We have the same bag.","Biziň sumkamyz meňzeş.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["different","/ˈdɪfrənt/","ADJ","dürli, başga","разный","not the same","two different answers.","iki dürli jogap","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"},{"book":"pre","unit":2}]],["very","/ˈveri/","ADV","örän, gaty","очень","used to make an adjective stronger","It is very cold.","Örän sowuk.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["really","/ˈrɪəli/","ADV","hakykatdan","действительно","used to say something is true or strong","It is really good.","Hakykatdan gowy.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"},{"book":"pre","unit":6,"lesson":"6C","page":50,"section":"vocabulary"}]],["quite","/kwaɪt/","ADV","birneme, has","довольно","used to mean a little more than average","It is quite cold today.","Bu gün birneme sowuk.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"},{"book":"pre","unit":6,"lesson":"6C","page":50,"section":"vocabulary"}]],["angry","/ˈæŋɡri/","ADJ","gaharly","злой","feeling that you want to shout at someone","She was angry with me.","Maňa gaharlydy.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":2,"lesson":"2C","page":18,"section":"vocabulary"}]],["frightened","/ˈfraɪtnd/","ADJ","goran, gorkan","испуганный","afraid of something","He was frightened of the dark.","Garanlykdan gorkýardy.","A2","Oxford 3000","—","frightened of","New",[{"book":"ele","unit":2,"lesson":"2C","page":18,"section":"vocabulary"},{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["stressed","/strest/","ADJ","dartgynly","в стрессе","worried and unable to relax","I feel stressed before exams.","Synaglardan öň dartgynly duýýaryn.","B1","Oxford 5000","—","—","New",[{"book":"ele","unit":2,"lesson":"2C","page":18,"section":"vocabulary"},{"book":"int","unit":4,"lesson":"4B","page":40,"section":"vocabulary"}]],["worried","/ˈwʌrid/","ADJ","aladaly","обеспокоенный","unhappy because you think about problems","She is worried about the test.","Synag barada aladaly.","A2","Oxford 3000","—","worried about","New",[{"book":"ele","unit":2,"lesson":"2C","page":18,"section":"vocabulary"}]],["do","/duː/","V","etmek","делать","to perform an action","I do my homework at night.","Öý işimi gije edýärin.","A1","Oxford 3000","—","do the housework","New",[{"book":"ele","unit":3,"lesson":"3A","page":22,"section":"vocabulary_bank"}]],["drive","/draɪv/","V","sürmek","водить","to control a car","He drives to work.","Işe maşynly gidýär.","A1","Oxford 3000","—","drive a car","New",[{"book":"ele","unit":3,"lesson":"3A","page":22,"section":"vocabulary_bank"}]],["go","/ɡəʊ/","V","gitmek","идти","to move from one place to another","I go to school by bus.","Mektbe awtobusda gidýärin.","A1","Oxford 3000","—","go home","New",[{"book":"ele","unit":2},{"book":"ele","unit":3,"lesson":"3A","page":22,"section":"vocabulary_bank"}]],["have","/hæv/","V","bolmak, bardy","иметь","to own or hold something","I have two brothers.","Iki agam bar.","A1","Oxford 3000","—","have a shower","New",[{"book":"ele","unit":3,"lesson":"3A","page":22,"section":"vocabulary_bank"}]],["listen","/ˈlɪsn/","V","diňlemek","слушать","to pay attention to a sound","Listen to the teacher.","Mugallymy diňläň.","A1","Oxford 3000","—","listen to","New",[{"book":"ele","unit":3,"lesson":"3A","page":22,"section":"vocabulary_bank"},{"book":"ele","unit":4},{"book":"pre","unit":8,"lesson":"8B","page":64,"section":"vocabulary_bank"}]],["take","/teɪk/","V","almak","брать","to get hold of something","Take your bag with you.","Sumkaňy özüň bilen al.","A1","Oxford 3000","—","take a photo","New",[{"book":"ele","unit":3,"lesson":"3A","page":22,"section":"vocabulary_bank"},{"book":"pre","unit":8,"lesson":"8B","page":64,"section":"vocabulary_bank"}]],["work","/wɜːk/","V","işlemek","работать","to do a job","He works in a bank.","Bankda işleýär.","A1","Oxford 3000","—","work in","New",[{"book":"ele","unit":3,"lesson":"3A","page":22,"section":"vocabulary_bank"},{"book":"ele","unit":6}]],["accountant","/əˈkaʊntənt/","N","hasapçy","бухгалтер","a person who keeps financial records","She is an accountant.","Ol hasapçy.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":3,"lesson":"3B","page":24,"section":"vocabulary_bank"}]],["administrator","/ədˈmɪnɪstreɪtə/","N","dolandyryjy","администратор","a person who organises a business or institution","She works as an administrator.","Dolandyryjy bolup işleýär.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":3,"lesson":"3B","page":24,"section":"vocabulary_bank"}]],["architect","/ˈɑːkɪtekt/","N","arhitektor","архитектор","a person who designs buildings","The architect designed this school.","Bu mekdebi arhitektor dizaýn etdi.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":3,"lesson":"3B","page":24,"section":"vocabulary_bank"}]],["builder","/ˈbɪldə/","N","gurluşykçy","строитель","a person whose job is building houses","My uncle is a builder.","Dayym gurluşykçy.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":3,"lesson":"3B","page":24,"section":"vocabulary_bank"}]],["chef","/ʃef/","N","aşpez","шеф-повар","a professional cook, especially in a restaurant","The chef made this dish.","Bu tagamy aşpez taýýarlady.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":3,"lesson":"3B","page":24,"section":"vocabulary_bank"},{"book":"intp","unit":6,"lesson":"6A","page":56,"section":"vocabulary_bank"}]],["cleaner","/ˈkliːnə/","N","arassalaýjy","уборщик","a person whose job is cleaning","The cleaner comes at six.","Arassalaýjy sagat altyda gelýär.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":3,"lesson":"3B","page":24,"section":"vocabulary_bank"}]],["dentist","/ˈdentɪst/","N","diş lukmany","стоматолог","a doctor for teeth","I go to the dentist twice a year.","Ýylda iki gezek diş lukmanyna barýaryn.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":3,"lesson":"3B","page":24,"section":"vocabulary_bank"}]],["driver","/ˈdraɪvə/","N","sürüji","водитель","a person who drives a vehicle","The bus driver is friendly.","Awtobus sürüjisi mähirli.","A1","Oxford 3000","—","bus driver","New",[{"book":"ele","unit":3,"lesson":"3B","page":24,"section":"vocabulary_bank"}]],["engineer","/ˌendʒɪˈnɪə/","N","injener","инженер","a person who designs machines or structures","He is an engineer.","Ol injener.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":3,"lesson":"3B","page":24,"section":"vocabulary_bank"},{"book":"pre","unit":11,"lesson":"11B","page":88,"section":"vocabulary"}]],["farmer","/ˈfɑːmə/","N","daýhan","фермер","a person who grows crops or keeps animals","The farmer has twenty cows.","Daýhanyň ýigrimi sygyry bar.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":3,"lesson":"3B","page":24,"section":"vocabulary_bank"}]],["journalist","/ˈdʒɜːnəlɪst/","N","jurnalist","журналист","a person who writes news reports","She is a journalist.","Ol jurnalist.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":3,"lesson":"3B","page":24,"section":"vocabulary_bank"},{"book":"pre","uni