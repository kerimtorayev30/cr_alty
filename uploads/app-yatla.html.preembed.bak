<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#F6FAF1">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Ýatla">
<title>Ýatla — Premium Offline Vocabulary Companion · UI/UX Prototype</title>
<style>
:root{
  --green:#58BE2F; --green-d:#3FA01F; --deep:#1F502D; --deep-2:#143D22;
  --ink:#22301E; --muted:#7A8873; --bg:#F6FAF1; --card:#FFFFFF;
  --mint:#E9F6DA; --mint-2:#D3EFB4; --line:#E7F0DF; --track:#EDF3E7;
  --orange:#F97316; --gold:#FACC15; --red:#EF4444; --purple:#8B5CF6;
  --teal:#14B8A6; --indigo:#6366F1; --pink:#EC4899; --blue:#3B82F6;
  --sh:0 2px 8px rgba(31,80,45,.06);
}
html[data-theme="dark"]{
  --ink:#EEF5E6; --muted:#93A587; --bg:#0B1009; --card:#151D11;
  --mint:#1C2A14; --mint-2:#22331A; --line:#27361F; --track:#1E2A17;
  --deep-2:#081A0C; --green:#6CCB43; --green-d:#57B32F; --gold:#FBD34D;
  --sh:0 2px 14px rgba(0,0,0,.55);
}
html[data-theme="dark"] .card{background:linear-gradient(180deg,#182212,#121909);border-color:#283720}
html[data-theme="dark"] .btn-p{box-shadow:0 4px 0 #3E8C22,0 0 22px rgba(108,203,67,.22)}
html[data-theme="dark"] .btn-p:disabled{background:#2E3B26;box-shadow:0 4px 0 #232D1D;color:#79876F}
html[data-theme="dark"] .btn-s{background:var(--mint);color:#9FE07C}
html[data-theme="dark"] [style*="FFF7DB"]{background:#28240F !important;border-color:#4A4220 !important;color:#EBD48A !important}
html[data-theme="dark"] [style*="FFF1E4"]{background:#2B1A0E !important}
html[data-theme="dark"] [style*="F5E3A1"]{border-color:#4A4220 !important}
html[data-theme="dark"] [style*="D8EDC4"]{border-color:#2C3D1F !important}
html[data-theme="dark"] .hcard[style*="FFF7DB"]{background:linear-gradient(120deg,#2A2513,var(--card)) !important}
html[data-theme="dark"] .tb{background:#0F1608;border-top-color:#222F19}
html[data-theme="dark"] .chip,html[data-theme="dark"] .icobtn{background:#182012}
html[data-theme="dark"] #toast{background:#243319;color:#DDF0CE}
html[data-theme="dark"] .lhero{background:var(--card)}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{font-family:ui-rounded,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  background:linear-gradient(160deg,#EFF7E6,#DCE9D3);color:var(--ink);min-height:100vh;transition:background .3s}
html[data-theme="dark"] body{background:linear-gradient(160deg,#0B100A,#101810)}
button{font:inherit;border:0;background:none;cursor:pointer;color:inherit}
img{display:block} svg{display:block}
.stage{display:flex;flex-wrap:wrap;gap:44px;justify-content:center;align-items:flex-start;padding:44px 22px 70px}
.pagehead{width:100%;text-align:center;margin-bottom:-6px}
.pagehead h1{font-size:30px;color:var(--deep);letter-spacing:-.5px}
html[data-theme="dark"] .pagehead h1{color:#BFE8AC}
.pagehead h1 b{color:var(--green)}
.pagehead p{color:var(--muted);font-size:14px;margin-top:6px}
.phone{width:390px;height:822px;flex:0 0 auto;border-radius:48px;border:10px solid #10190F;
  background:var(--bg);overflow:hidden;position:relative;
  box-shadow:0 30px 70px rgba(20,61,34,.35),0 4px 14px rgba(20,61,34,.2)}
.screen{position:absolute;inset:0;display:none;flex-direction:column;background:var(--bg)}
.screen.on{display:flex;animation:scr .28s ease}
@keyframes scr{from{opacity:.35;transform:translateX(14px)}to{opacity:1;transform:none}}
.scroll{flex:1;overflow-y:auto;padding:0 18px 16px;scrollbar-width:none}
.scroll::-webkit-scrollbar{display:none}
.sb{display:flex;justify-content:space-between;align-items:center;padding:14px 24px 4px;font-weight:800;font-size:14px;color:var(--ink)}
.sb svg{width:52px;height:12px;color:var(--ink)}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;box-shadow:var(--sh)}
.chip{display:inline-flex;align-items:center;gap:5px;background:var(--card);border:1px solid var(--line);
  border-radius:999px;padding:5px 10px;font-weight:800;font-size:12.5px;box-shadow:var(--sh)}
.icobtn{width:42px;height:42px;border-radius:14px;background:var(--card);border:1px solid var(--line);
  display:grid;place-items:center;box-shadow:var(--sh);position:relative}
.icobtn svg{width:20px;height:20px}
.btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:15px 18px;
  border-radius:16px;font-weight:800;font-size:15.5px;letter-spacing:.2px;transition:transform .08s,filter .15s}
.btn:active{transform:translateY(2px)}
.btn-p{background:var(--green);color:#fff;box-shadow:0 4px 0 var(--green-d)}
.btn-p:disabled{background:#CFE3C4;color:#fff;box-shadow:0 4px 0 #B9D2AC;cursor:default}
.btn-g{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.35)}
.btn-s{background:var(--mint);color:var(--green-d);box-shadow:none}
.link{color:var(--green);font-weight:800;font-size:12.5px}
.h2{font-size:17px;font-weight:800}
.sub{color:var(--muted);font-size:12.5px}
.row{display:flex;align-items:center}
.spread{justify-content:space-between}
.tb{display:flex;justify-content:space-around;align-items:flex-end;background:var(--card);border-top:1px solid var(--line);padding:9px 6px 14px}
.tbi{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:10.5px;font-weight:700;color:var(--muted);
  padding:4px 8px;border-radius:12px;min-width:56px}
.tbi svg{width:22px;height:22px}
.tbi.on{color:var(--green)}
.sec{margin:18px 2px 10px}
/* onboarding */
#scr-onboard{background:var(--mint-2)}
.ob-head{padding:2px 26px 0;text-align:center}
.ob-logo{font-size:15px;font-weight:800;color:var(--green-d);letter-spacing:2px}
.ob-head h1{font-size:24px;line-height:1.22;letter-spacing:-.4px;margin-top:4px}
.ob-head p{color:var(--muted);font-size:12px;margin-top:8px;line-height:1.5}
.hero{width:100%;margin-top:2px}
.ob-dark{margin-top:auto;background:var(--deep-2);border-radius:28px 28px 0 0;padding:22px 24px 24px;display:flex;flex-direction:column;gap:12px}
.divrow{display:flex;align-items:center;gap:10px;color:rgba(255,255,255,.55);font-size:12px;font-weight:600}
.divrow i{flex:1;height:1px;background:rgba(255,255,255,.22)}
.social{display:flex;gap:12px;justify-content:center}
.soc{width:58px;height:52px;border-radius:14px;background:rgba(255,255,255,.07);border:1.5px solid rgba(255,255,255,.22);display:grid;place-items:center}
.soc svg{width:22px;height:22px;color:#fff}
.terms{text-align:center;color:rgba(255,255,255,.6);font-size:11.5px;line-height:1.6}
.terms a{color:#9BE27A;font-weight:700;text-decoration:underline}
/* home */
.brand{font-size:21px;font-weight:800;color:var(--green-d);letter-spacing:.3px}
html[data-theme="dark"] .brand{color:#8ED968}
.brand i{font-style:normal;color:var(--gold)}
.greet{margin:12px 2px 12px}
.greet h2{font-size:23px;letter-spacing:-.4px}
.greet p{color:var(--muted);font-size:12.5px;margin-top:2px}
.stick{width:72px;height:72px;border-radius:50%;overflow:hidden;border:4px solid var(--card);
  box-shadow:0 6px 16px rgba(31,80,45,.18);background:var(--card);animation:bob 2.6s ease-in-out infinite;flex:0 0 auto}
.stick img{width:135%;height:135%;object-fit:cover;object-position:50% 42%;margin:-14%}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
.hcard{padding:11px 14px;margin-top:10px}
.hcard .lab{font-size:10.5px;font-weight:800;color:var(--muted);letter-spacing:.6px}
.pbar{height:10px;border-radius:999px;background:var(--track);margin-top:10px;position:relative}
.pbar i{position:absolute;inset:0 auto 0 0;border-radius:999px;background:var(--green);transition:width .6s ease}
.pbar em{position:absolute;top:50%;transform:translate(-108%,-50%);background:var(--card);color:var(--green-d);
  font-style:normal;font-size:9.5px;font-weight:800;border-radius:6px;padding:2px 5px;box-shadow:var(--sh)}
.cont{position:relative;overflow:hidden;background:linear-gradient(135deg,#25603A,var(--deep));border:0;color:#fff}
.cont .lab{color:#BFE8AC}
.cont h3{font-size:16px;margin-top:3px}
.cont .les{font-size:12px;color:#CFE8C2;margin-top:1px}
.cont .btn{width:auto;padding:10px 20px;font-size:13.5px;border-radius:12px;margin-top:12px}
.cont img{position:absolute;right:-6px;bottom:-4px;width:126px;border-radius:14px 0 0 0}
.gift svg{width:30px;height:30px;color:var(--gold)}
.gico{width:36px;height:36px;border-radius:11px;background:var(--mint);display:grid;place-items:center;flex:0 0 auto}
.gico svg{width:18px;height:18px;color:var(--green-d)}
.ck{width:22px;height:22px;border-radius:50%;border:2.5px solid #CBDCC0;display:grid;place-items:center;flex:0 0 auto}
.ck svg{width:12px;height:12px;color:#fff}
.ck.done{background:var(--green);border-color:var(--green)}
.bars{display:flex;gap:9px;align-items:flex-end;height:96px;padding:6px 2px 0}
.barw{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;height:100%;justify-content:flex-end}
.bar{width:100%;border-radius:8px 8px 5px 5px;background:linear-gradient(#8ED968,var(--green))}
.bar.dim{background:var(--track)}
.barw span{font-size:10px;font-weight:800;color:var(--muted)}
.barw.now span{color:var(--green-d)}
.lp{background:linear-gradient(135deg,#2B7042,var(--deep));border:0;color:#fff;cursor:pointer}
.lp .med{width:44px;height:44px;border-radius:14px;background:rgba(255,255,255,.14);display:grid;place-items:center;flex:0 0 auto}
.lp .med svg{width:22px;height:22px;color:var(--gold)}
.wotd{background:linear-gradient(135deg,var(--mint),var(--card));border-color:#D8EDC4}
.wotd .w{font-size:19px;font-weight:800}
.wotd .ipa{color:var(--muted);font-size:12px;font-weight:600;margin-left:8px}
.spk2{width:34px;height:34px;border-radius:11px;background:var(--mint);display:grid;place-items:center;flex:0 0 auto}
.spk2 svg{width:16px;height:16px;color:var(--green-d)}
.act .ai{width:40px;height:40px;border-radius:13px;background:var(--mint);display:grid;place-items:center;flex:0 0 auto}
.act .ai svg{width:19px;height:19px;color:var(--green-d)}
/* learning */
.brow{padding:12px;margin-top:10px;cursor:pointer}
.brow .cov{width:62px;height:84px;border-radius:6px 10px 10px 6px;padding:8px 6px 8px 10px;display:flex;flex-direction:column;
  color:#fff;position:relative;flex:0 0 auto}
.brow .cov::before{content:"";position:absolute;left:5px;top:0;bottom:0;width:2px;background:rgba(255,255,255,.4)}
.brow .cov .ox{font-size:6.5px;letter-spacing:1.2px;font-weight:800;opacity:.9}
.brow .cov .t{font-size:10.5px;font-weight:800;line-height:1.1;margin-top:3px}
.brow .cov .lv{margin-top:auto;align-self:flex-start;background:rgba(255,255,255,.25);border-radius:6px;padding:2px 6px;font-size:8.5px;font-weight:800}
.brow b{font-size:14px}
.brow .meta{font-size:11px;color:var(--muted);font-weight:700;margin-top:2px}
.dlbar{height:6px;border-radius:99px;background:var(--track);margin-top:8px;position:relative;overflow:hidden}
.dlbar i{position:absolute;inset:0 auto 0 0;background:var(--blue);border-radius:99px;transition:width .3s}
.urow{padding:13px 14px;margin-top:9px;cursor:pointer}
.unum{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font-weight:800;color:#fff;flex:0 0 auto}
.urow .st{font-size:9.5px;font-weight:800;border-radius:6px;padding:3px 8px}
.vtop{display:flex;align-items:center;gap:12px;padding:6px 2px 12px}
.vcard{padding:22px 20px;text-align:center}
.vword{font-size:30px;font-weight:800;letter-spacing:-.5px}
.vipa{color:var(--muted);font-size:13.5px;font-weight:600;margin-top:4px}
.vpos{display:inline-block;margin-top:8px;font-size:10px;font-weight:800;letter-spacing:1px;color:var(--green-d);background:var(--mint);border-radius:7px;padding:4px 10px}
.vstage{display:inline-block;margin-top:8px;margin-left:6px;font-size:10px;font-weight:800;border-radius:7px;padding:4px 10px;color:#fff}
.vtr{font-size:19px;font-weight:800;color:var(--green-d);margin-top:14px}
html[data-theme="dark"] .vtr{color:#8ED968}
.vru{font-size:12.5px;color:var(--muted);font-weight:700;margin-top:2px}
.vdef{font-size:13px;color:var(--muted);margin-top:12px;line-height:1.5}
.vex{margin-top:12px;background:var(--mint);border-radius:12px;padding:11px 14px;font-size:13.5px;font-weight:700}
.vex span{display:block;font-size:12px;color:var(--muted);font-weight:600;margin-top:3px}
.vbtns{display:flex;gap:10px;margin-top:14px}
.vbtns .btn{padding:13px}
.favb{width:52px;height:52px;border-radius:16px;background:var(--mint);display:grid;place-items:center;flex:0 0 auto}
.favb svg{width:24px;height:24px;color:#C4D4B8}
.favb.on svg{color:var(--red);animation:fpop .3s ease}
@keyframes fpop{0%{transform:scale(1)}45%{transform:scale(1.35)}100%{transform:scale(1)}}
/* review */
.dots{display:flex;gap:6px;justify-content:center;padding:4px 0 14px}
.dot{width:9px;height:9px;border-radius:50%;background:var(--track)}
.dot.done{background:var(--green)} .dot.cur{background:var(--gold);transform:scale(1.25)}
.flip{perspective:900px;height:250px;margin:6px 0 14px;cursor:pointer}
.fcard{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .35s}
.flip.flipped .fcard{transform:rotateY(180deg)}
.fface{position:absolute;inset:0;backface-visibility:hidden;border-radius:20px;display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:8px;padding:20px}
.fface.f{background:var(--card);border:1px solid var(--line);box-shadow:var(--sh)}
.fface.b{background:linear-gradient(135deg,#2B7042,var(--deep));color:#fff;transform:rotateY(180deg)}
.fface .w{font-size:26px;font-weight:800}
.blankin{width:100%;padding:14px 16px;border-radius:14px;border:2px solid var(--line);background:var(--card);
  font:inherit;font-size:16px;font-weight:700;color:var(--ink);outline:none;text-align:center}
.blankin:focus{border-color:var(--green)}
.fb{display:none;align-items:center;gap:12px;border-radius:16px;padding:13px 16px;margin-bottom:10px}
.fb.ok{display:flex;background:#E8F8DE} .fb.no{display:flex;background:#FDECEC}
html[data-theme="dark"] .fb.ok{background:#1B3312} html[data-theme="dark"] .fb.no{background:#3A1512}
.fb .fic{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;flex:0 0 auto}
.fb.ok .fic{background:var(--green)} .fb.no .fic{background:var(--red)}
.fb .fic svg{width:18px;height:18px;color:#fff}
.fb b{font-size:14px} .fb.ok b{color:var(--green-d)} .fb.no b{color:#C23B3B}
html[data-theme="dark"] .fb.ok b{color:#8ED968} html[data-theme="dark"] .fb.no b{color:#F87171}
/* search */
.sbar{padding:12px 14px;gap:10px}
.sbar input{border:0;outline:0;flex:1;font:inherit;font-size:14px;font-weight:600;color:var(--ink);background:transparent}
.sbar>svg{width:19px;height:19px;color:var(--muted)}
.chips{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.rchip{background:var(--card);border:1px solid var(--line);border-radius:999px;padding:7px 12px;font-size:12px;font-weight:700;color:var(--muted)}
.rchip.on{background:var(--mint);border-color:#BFDE9F;color:var(--green-d)}
.wrow{padding:13px 16px;margin-top:9px;cursor:pointer}
.lrow{padding:13px 16px;margin-top:9px;cursor:pointer;transition:transform .12s}
/* --- real coursebook covers and the roomier unit screen --- */
.covimg{width:72px;height:96px;object-fit:cover;border-radius:5px 10px 10px 5px;flex:0 0 auto;
 background:#fff;box-shadow:2px 4px 10px rgba(31,80,45,.30)}
.uhead{display:flex;gap:12px;align-items:center;padding:12px 2px 6px}
/* --- motion: views settle in, screens cross-fade, tabs carry a sliding pill --- */
#lv>*{animation:lvIn .32s cubic-bezier(.2,.8,.2,1) both}
@keyframes lvIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.screen.on{animation:scrIn .3s cubic-bezier(.2,.8,.2,1)}
@keyframes scrIn{from{opacity:.35}to{opacity:1}}
.tb{position:relative}
.tbpill{position:absolute;bottom:8px;height:34px;border-radius:12px;background:linear-gradient(180deg,#F2FAE6,var(--mint));
 box-shadow:0 3px 14px rgba(31,80,45,.13);z-index:0;
 transition:left .32s cubic-bezier(.3,.9,.35,1),width .32s cubic-bezier(.3,.9,.35,1)}
.tbi{position:relative;z-index:1;transition:color .25s,transform .12s}
.tbi:active{transform:scale(.94)}
html[data-theme="dark"] .tbpill{background:linear-gradient(180deg,#1D2616,#182012);box-shadow:0 3px 14px rgba(0,0,0,.5)}
.lrow:active{transform:scale(.985)}
.lcode{flex-shrink:0;min-width:38px;text-align:center;font-size:12.5px;font-weight:800;
 letter-spacing:.02em;color:var(--green-d);background:var(--mint);border-radius:9px;padding:5px 8px}
.ltag{text-align:center;margin-bottom:9px;font-size:11.5px;color:var(--muted);font-weight:700}
.ltag span{color:var(--deep);letter-spacing:.03em}
.ltag i{font-style:normal;opacity:.8}
.ltag span+i::before{content:" · "}
.wrow b{font-size:14.5px}
.wrow .en{display:block;color:var(--muted);font-size:12.5px;font-weight:700;margin-top:1px}
.pos{font-size:9.5px;font-weight:800;color:var(--green-d);background:var(--mint);border-radius:6px;padding:3px 7px;letter-spacing:.5px}
.dgrid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:12px}
.dstat{padding:10px;text-align:center}
.dstat b{font-size:15px} .dstat span{display:block;font-size:10px;color:var(--muted);font-weight:800;margin-top:1px}
.dline{padding:11px 2px;border-bottom:1px dashed var(--line);font-size:13px}
.dline:last-child{border:0}
.dline .k{color:var(--muted);font-weight:700;font-size:11px;letter-spacing:.4px;display:block;margin-bottom:2px}
/* league */
.tiers{display:flex;justify-content:space-between;padding:12px 8px}
.tier{display:flex;flex-direction:column;align-items:center;gap:4px;font-size:9px;font-weight:800;color:var(--muted);transition:transform .2s}
.tier i{position:relative;width:38px;height:38px;border-radius:50%;display:grid;place-items:center}
.tier i svg{width:31px;height:31px}
.tier.lock i{opacity:.3;filter:grayscale(1)}
.tier.on{color:var(--ink);transform:translateY(-2px)}
.tier.on i{filter:drop-shadow(0 3px 8px rgba(0,0,0,.28))}
.tier.on span{background:var(--mint);border-radius:7px;padding:2px 6px;color:var(--green-d)}
.lhero{padding:15px 16px 12px;border-radius:20px;border:1px solid var(--line);background:var(--card);transition:background .3s,border-color .3s}
.lhero[data-t="bz"]{background:linear-gradient(135deg,#F5E5D3,var(--card) 65%);border-color:#E2C6A6}
.lhero[data-t="sv"]{background:linear-gradient(135deg,#E9EEF4,var(--card) 65%);border-color:#C9D4DE}
.lhero[data-t="gd"]{background:linear-gradient(135deg,#FFF1CB,var(--card) 65%);border-color:#EED788}
.lhero[data-t="sp"]{background:linear-gradient(135deg,#D9E7FF,var(--card) 65%);border-color:#B4C9EC}
.lhero[data-t="em"]{background:linear-gradient(135deg,#D6F2E3,var(--card) 65%);border-color:#A8D9C0}
.lhero[data-t="lg"]{background:linear-gradient(135deg,#F4DCF6,var(--card) 65%);border-color:#DBB3E3}
.lshield{width:84px;height:84px;flex:0 0 auto;filter:drop-shadow(0 5px 12px rgba(0,0,0,.22));animation:lfloat 3.2s ease-in-out infinite}
@keyframes lfloat{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-5px) rotate(2deg)}}
.lshield svg{width:84px;height:84px}
.ltiername{font-size:17px;font-weight:800;letter-spacing:.2px}
.lpbar{height:7px;border-radius:99px;background:rgba(0,0,0,.09);margin:7px 0 4px;overflow:hidden}
.lpbar i{display:block;height:100%;border-radius:99px;background:var(--green);transition:width .5s}
.lsub{margin-top:11px;padding-top:9px;border-top:1px dashed var(--line);font-size:10px;font-weight:800;color:var(--muted);letter-spacing:.5px;text-transform:uppercase}
html[data-theme="dark"] .lhero[data-t]{background:linear-gradient(135deg,#1D2918,var(--card) 60%)}
html[data-theme="dark"] .lpbar{background:rgba(255,255,255,.1)}
.rrow.top1 b::before{content:"👑 ";font-size:11px}
.rrow{display:flex;align-items:center;gap:11px;padding:11px 14px}
.rrow + .rrow{border-top:1px solid var(--line)}
.rk{width:20px;text-align:center;font-weight:800;font-size:13px;color:var(--muted)}
.rk.g{color:var(--gold)}.rk.s{color:#9AA7B1}.rk.b{color:#C08552}
.rav{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;color:#fff;font-size:12.5px;font-weight:800;flex:0 0 auto}
.rrow b{font-size:13.5px}
.rrow .xp{margin-left:auto;font-weight:800;font-size:12.5px;color:var(--muted)}
.rrow.me{background:var(--mint)}
.youchip{font-size:9px;background:var(--green);color:#fff;border-radius:6px;padding:2px 6px;margin-left:6px;font-weight:800}
.cut{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:9.5px;font-weight:800;letter-spacing:.6px;padding:10px 6px}
.cut i{flex:1;border-top:2px dashed var(--line)}
/* profile */
.avatar{position:relative;width:76px;height:76px;flex:0 0 auto}
.avatar img{width:76px;height:76px;border-radius:50%;object-fit:cover;border:3px solid var(--card);box-shadow:0 4px 12px rgba(31,80,45,.18)}
.avatar .cam{position:absolute;right:-2px;bottom:-2px;width:26px;height:26px;border-radius:50%;background:var(--green);display:grid;place-items:center;border:2.5px solid var(--card)}
.avatar .cam svg{width:12px;height:12px;color:#fff}
.badge{display:inline-block;margin-top:6px;background:var(--mint);color:#4E7A38;font-size:11px;font-weight:800;border-radius:999px;padding:5px 12px}
html[data-theme="dark"] .badge{color:#8ED968}
.badge.pr{background:linear-gradient(90deg,#8B5CF6,#6D28D9);color:#fff}
.menu{overflow:hidden}
.mrow{display:flex;align-items:center;gap:13px;padding:14px 16px;width:100%;text-align:left}
.mrow + .mrow{border-top:1px solid var(--line)}
.mico{width:40px;height:40px;border-radius:13px;display:grid;place-items:center;flex:0 0 auto}
.mico svg{width:20px;height:20px;color:#fff}
.mrow b{font-size:14px}
.mrow .val{font-size:12px;color:var(--muted);font-weight:700}
.mrow .chev svg{width:17px;height:17px;color:var(--muted)}
.achs{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:4px}
.ach{padding:12px 4px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:6px}
.ach svg{width:28px;height:28px}
.ach b{font-size:10px;color:var(--muted)}
.ach.locked{opacity:.38;filter:grayscale(1)}
.prem{padding:16px;border:1px solid #3A2E12 !important;color:#F3E9CE;position:relative;overflow:hidden;
 background:radial-gradient(120% 90% at 85% 0%,rgba(250,204,21,.16),transparent 55%),linear-gradient(150deg,#1C1608,#12100A 60%,#1A1408)}
.prem::after{content:"";position:absolute;top:-60%;left:-40%;width:36%;height:220%;transform:rotate(20deg);
 background:linear-gradient(90deg,transparent,rgba(255,235,170,.16),transparent);animation:shine 3.8s ease-in-out infinite;pointer-events:none}
@keyframes shine{0%{left:-45%}55%,100%{left:125%}}
.premtag{font-size:12px;font-weight:800;letter-spacing:2.5px;color:#D6B657}
.premtag b{background:linear-gradient(90deg,#FDE68A,#F0B429);-webkit-background-clip:text;background-clip:text;color:transparent}
.premfeat{display:flex;flex-direction:column;gap:6px;margin:13px 0 10px;font-size:12.5px;font-weight:700;color:#D9CBa0}
.premfeat b{color:#F6EBC9}
.premstat{display:block;font-size:11px;color:#B7A878;font-weight:700}
.premcta{margin-top:11px;background:linear-gradient(90deg,#F6C453,#E39B16);color:#2A1E05;box-shadow:0 4px 0 #A9720D,0 0 24px rgba(240,180,41,.35)}
.premcta:active{transform:translateY(2px)}
.premcancel{margin-top:9px;width:100%;text-align:center;font-size:11px;font-weight:700;color:#9C8D63;text-decoration:underline}
.prem.act{border-color:#C9A227 !important;box-shadow:0 0 0 1px rgba(201,162,39,.4),0 8px 30px rgba(227,155,22,.25);
 background:radial-gradient(120% 90% at 85% 0%,rgba(250,204,21,.32),transparent 55%),linear-gradient(150deg,#2A2008,#1A1408 60%,#241A06)}
.prem.act .premtag{color:#F3D98A}
.prem.act .premcta{background:linear-gradient(90deg,#4ADE80,#16A34A);color:#fff;box-shadow:0 4px 0 #15803D,0 0 20px rgba(34,197,94,.3)}
.prem.act .premstat{color:#E4D49A}
.avatar.ring img{border:3px solid #F0B429;box-shadow:0 0 0 3px rgba(240,180,41,.28),0 4px 14px rgba(0,0,0,.32)}
.vb{display:inline-block;width:16px;height:16px;vertical-align:-3px;flex:0 0 auto}
.premrib{display:flex;align-items:center;gap:8px;margin-top:10px;padding:9px 14px;font-size:12.5px;font-weight:800;
 background:linear-gradient(90deg,#FFF3CF,#FFE7A3);border:1px solid #EBD089;color:#6B5310;border-radius:16px;
 box-shadow:0 2px 10px rgba(227,155,22,.18)}
.premrib .x2{margin-left:auto;background:#E39B16;color:#fff;border-radius:999px;padding:3px 9px;font-size:11px}
html[data-theme="dark"] .premrib{background:linear-gradient(90deg,#2E2410,#3A2C0E);border-color:#5C4A18;color:#E9D491}
.x2chip{display:inline-flex;align-items:center;gap:4px;background:linear-gradient(90deg,#F6C453,#E39B16);color:#2A1E05;
 border-radius:999px;padding:4px 9px;font-weight:800;font-size:11px;box-shadow:0 2px 8px rgba(227,155,22,.35)}
html.premium .tbi.on{color:#D99E1B}
html.premium .tbi.on svg{filter:drop-shadow(0 0 7px rgba(217,158,27,.55))}
html.premium .chip{border-color:#E9D9A6}
html.premium .btn-p{box-shadow:0 4px 0 var(--green-d),0 0 18px rgba(227,155,22,.25)}
html.premium .brand{background:linear-gradient(90deg,var(--green-d) 55%,#C98A0E);-webkit-background-clip:text;background-clip:text;color:transparent}
.sw{width:46px;height:27px;border-radius:999px;background:var(--track);position:relative;transition:.2s;flex:0 0 auto}
.sw::after{content:"";position:absolute;left:3px;top:3px;width:21px;height:21px;border-radius:50%;background:#fff;transition:.2s;box-shadow:0 1px 3px rgba(0,0,0,.3)}
.sw.on{background:var(--green)}
.sw.on::after{left:22px}
.seg{display:flex;background:var(--track);border-radius:12px;padding:3px;gap:3px}
.seg button{flex:1;padding:8px 4px;border-radius:9px;font-size:12px;font-weight:800;color:var(--muted)}
.seg button.on{background:var(--card);color:var(--green-d);box-shadow:var(--sh)}
html[data-theme="dark"] .seg button.on{color:#8ED968}
.favchips{display:flex;flex-wrap:wrap;gap:8px;padding:4px 2px}
/* lesson */
#scr-lesson{background:var(--bg)}
.ltop{display:flex;align-items:center;gap:12px;padding:14px 20px 6px}
.ltop .x svg{width:20px;height:20px;color:var(--muted)}
.ltop .tr{flex:1;height:12px;border-radius:999px;background:var(--track);position:relative}
.ltop .tr i{position:absolute;inset:0 auto 0 0;width:40%;border-radius:999px;background:var(--green)}
.ltop .hp{display:flex;align-items:center;gap:5px;font-weight:800;color:var(--red);font-size:14px}
.ltop .hp svg{width:19px;height:19px}
.lbody{flex:1;overflow-y:auto;padding:14px 20px 12px}
.qlab{font-size:12px;font-weight:800;color:var(--muted);letter-spacing:.6px}
.qcard{display:flex;align-items:center;gap:12px;margin-top:12px;padding:14px 16px}
.opts{display:flex;flex-direction:column;gap:10px;margin-top:18px}
.opt{padding:15px 18px;border-radius:14px;border:2px solid var(--line);background:var(--card);font-weight:700;font-size:15px;
  text-align:left;box-shadow:0 2.5px 0 var(--line);transition:.12s;color:var(--ink)}
.opt.sel{border-color:var(--green);background:var(--mint);color:var(--green-d);box-shadow:0 2.5px 0 #BFDE9F}
.lfoot{padding:14px 20px 22px;border-top:2px solid var(--line)}
/* spec */
.spec{width:370px;max-width:100%;display:flex;flex-direction:column;gap:16px}
.scard{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:20px 22px;box-shadow:0 8px 26px rgba(31,80,45,.08)}
.scard h3{font-size:14px;color:var(--deep);letter-spacing:.4px;text-transform:uppercase;margin-bottom:12px}
html[data-theme="dark"] .scard h3{color:#BFE8AC}
.sws{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.swi{display:flex;align-items:center;gap:9px;font-size:11.5px;font-weight:700;color:var(--muted)}
.swi i{width:30px;height:30px;border-radius:9px;flex:0 0 auto;border:1px solid rgba(0,0,0,.06)}
.spec ul{padding-left:18px;display:flex;flex-direction:column;gap:7px;font-size:12.5px;color:var(--muted);line-height:1.5}
.spec li b{color:var(--ink)}
.hint{font-size:11.5px;color:var(--muted);text-align:center}
#toast{position:absolute;left:50%;bottom:96px;transform:translateX(-50%) translateY(16px);background:var(--deep);
 color:#fff;padding:10px 18px;border-radius:999px;font-weight:800;font-size:13px;opacity:0;pointer-events:none;
 transition:.25s;z-index:60;box-shadow:0 8px 20px rgba(0,0,0,.3);white-space:nowrap}
#toast.show{opacity:1;transform:translateX(-50%)}
.a_in{width:100%;padding:13px 16px;border-radius:14px;border:2px solid var(--line);background:var(--card);
 font:inherit;font-size:14px;font-weight:600;color:var(--ink);margin-top:10px;outline:none}
.a_in:focus{border-color:var(--green)}
.a_err{color:#C23B3B;font-size:12px;font-weight:700;margin-top:8px;min-height:16px}
.cf{position:absolute;top:-12px;width:8px;height:12px;border-radius:2px;z-index:70;pointer-events:none;animation:cf fall linear forwards}
@keyframes cf{to{transform:translateY(860px) rotate(720deg);opacity:.2}}
/* ===== review: multiple-choice options ===== */
.opts2{display:flex;flex-direction:column;gap:10px;margin-top:14px}
.opt2{text-align:left;padding:15px 16px;border-radius:16px;background:var(--card);border:2px solid var(--line);
 font-size:15px;font-weight:700;color:var(--ink);box-shadow:0 3px 0 var(--line);cursor:pointer;
 transition:transform .12s,border-color .2s,background .2s,color .2s}
.opt2:active{transform:scale(.98)}
.opt2.right{border-color:var(--green);background:var(--mint);color:var(--green-d)}
.opt2.wrong{border-color:var(--red);background:#FEE2E2;color:#B91C1C}
.opt2:disabled{cursor:default;opacity:.92}
/* ===== unit / lesson complete: celebratory badge ===== */
.cdone{text-align:center;padding:28px 10px 4px}
.cbadge{width:94px;height:94px;margin:0 auto;border-radius:50%;display:flex;align-items:center;justify-content:center;
 background:radial-gradient(circle at 35% 28%,#9BE07A,#58BE2F 62%,#3E9B1F);
 box-shadow:0 10px 26px rgba(88,190,47,.42),inset 0 -4px 10px rgba(0,0,0,.13);
 animation:popIn .55s cubic-bezier(.2,1.35,.4,1) both,badgePulse 1.7s ease-in-out .6s infinite}
@keyframes popIn{0%{transform:scale(.3) rotate(-14deg);opacity:0}60%{transform:scale(1.1)}100%{transform:scale(1);opacity:1}}
@keyframes badgePulse{0%,100%{box-shadow:0 10px 26px rgba(88,190,47,.42),inset 0 -4px 10px rgba(0,0,0,.13)}
 50%{box-shadow:0 12px 36px rgba(88,190,47,.7),inset 0 -4px 10px rgba(0,0,0,.13)}}
/* ===== installed-app mode on mobile: frame & backdrop disappear ===== */
@media (max-width:640px){
  html,body{height:100%}
  body{background:var(--bg);overflow:hidden}
  .stage{display:block;padding:0}
  .pagehead,.spec{display:none}
  .phone{width:100%;height:100vh;height:100dvh;border:0;border-radius:0;box-shadow:none}
  .sb{padding-top:calc(14px + env(safe-area-inset-top))}
  .tb{padding-bottom:calc(14px + env(safe-area-inset-bottom))}
  .lfoot{padding-bottom:calc(22px + env(safe-area-inset-bottom))}
  .ob-dark{padding-bottom:calc(24px + env(safe-area-inset-bottom))}
}
</style>
