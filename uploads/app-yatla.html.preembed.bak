        <button class="opt gsel" data-g="25" style="margin-top:20px;text-align:left"><span style="font-size:20px;margin-right:10px">🌱</span><span data-i18n="g_casual">Casual</span><span class="sub" style="margin-left:auto" data-i18n="g_casual_s">5 words / day</span></button>
        <button class="opt gsel" data-g="35" style="margin-top:10px;text-align:left"><span style="font-size:20px;margin-right:10px">🌿</span><span data-i18n="g_regular">Regular</span><span class="sub" style="margin-left:auto" data-i18n="g_regular_s">10 words / day</span></button>
        <button class="opt gsel sel" data-g="50" style="margin-top:10px;text-align:left"><span style="font-size:20px;margin-right:10px">🔥</span><span data-i18n="g_serious">Serious</span><span class="sub" style="margin-left:auto" data-i18n="g_serious_s">15 words / day</span></button>
