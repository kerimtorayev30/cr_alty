            <div class="card ach"><svg style="color:var(--orange)"><use href="#i-flame"/></svg><b data-i18n="ach1">On Fire</b></div>
            <div class="card ach"><svg style="color:var(--gold)"><use href="#i-trophy"/></svg><b data-i18n="ach2">Champion</b></div>
            <div class="card ach"><svg style="color:var(--purple)"><use href="#i-bolt"/></svg><b data-i18n="ach3">Fast XP</b></div>
            <div class="card ach locked"><svg style="color:var(--muted)"><use href="#i-globe"/></svg><b data-i18n="ach4">Polyglot</b></div>
          </div>
        </div>
        <div class="sec row spread"><span class="h2" data-i18n="favorites">Favorites</span><span class="sub" id="favcount"></span></div>
        <div class="favchips" id="favchips"></div>
        <div class="sec row spread"><span class="h2" data-i18n="dl_books">Downloaded Books</span><span class="sub" data-i18n="storage">312 MB of 2 GB</span></div>
        <div class="card menu" id="dlbooks"></div>
        <div class="card prem" id="premCard" style="margin-top:14px">
          <div class="row spread" style="align-items:center">
            <div class="premtag">ÝATLA <b>PREMIUM</b></div>
            <svg style="width:42px;height:42px;filter:drop-shadow(0 3px 8px rgba(227,155,22,.45))"><use href="#i-crown"/></svg>
          </div>
          <div class="premfeat">
            <span>✓ <b data-i18n="prem_f1">Unlimited reviews</b></span>
            <span>✓ <b data-i18n="prem_f2">Advanced analytics</b></span>
            <span>✓ <b data-i18n="prem_f3">Gold badge, crown & themes</b></span>
          </div>
          <span class="premstat" id="premStatus" data-i18n="prem_status">Free plan · upgrade to unlock everything</span>
          <button class="btn premcta" id="premBtn" data-i18n="prem_cta">✨ Get Premium</button>
          <button class="premcancel" id="premCancel" style="display:none" data-i18n="prem_cancel">Cancel Premium (demo)</button>
        </div>
        <div class="sec row spread" id="setSec"><span class="h2" data-i18n="settings">Settings</span><button class="link" id="setTop" style="font-size:12px" data-i18n="back_top">Back to top</button></div>
        <div class="card menu">
          <div class="mrow"><span class="mico" style="background:var(--blue)"><svg><use href="#i-globe"/></svg></span>
            <div style="flex:1"><b data-i18n="lang_t">Interface language</b><br><span class="val" data-i18n="lang_sub">Instant switch · learning stays English</span></div>
            <div class="seg" id="langSegTop"><button data-l="en" class="on">EN</button><button data-l="tk">TM</button><button data-l="ru">RU</button></div>
          </div>
