rrots.","çig käşir","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["chips","/tʃɪps/","N","kartoşka fri","картофель фри","long pieces of fried potato","fish and chips.","balyk bilen kartoşka fri","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["lettuce","/ˈletɪs/","N","salat ýapragy","салат","a plant with green leaves eaten raw","a lettuce.","bir salat ýapragy","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["mushrooms","/ˈmʌʃruːmz/","N","kömelek","грибы","soft round things you eat","fried mushrooms.","gowrulan kömelek","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["onions","/ˈʌnjənz/","N","sogan","лук","round vegetables with a strong smell","chopped onions.","dogranan sogan","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["peas","/piːz/","N","noýba","горох","small green seeds you eat","peas and carrots.","noýba bilen käşir","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["peppers","/ˈpepəz/","N","bolgar burçy","перец","hollow red or green vegetables","red peppers.","gyzyl bolgar burçy","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["tomatoes","/təˈmɑːtəʊz/","N","pomidor","помидоры","soft red vegetables","tomatoes and cheese.","pomidor bilen peýnir","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["apples","/ˈæplz/","N","alma","яблоки","round fruit with green or red skin","two apples.","iki alma","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["bananas","/bəˈnɑːnəz/","N","banan","бананы","long yellow fruit","ripe bananas.","bişen banan","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["oranges","/ˈɒrɪndʒɪz/","N","pytykal","апельсины","round orange fruit","sweet oranges.","süýji pytykal","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["pineapple","/ˈpaɪnæpl/","N","ananas","ананас","a large tropical fruit","a slice of pineapple.","bir dilim ananas","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["strawberries","/ˈstrɔːbəriz/","N","ýer tudana","клубника","small soft red fruit","strawberries and cream.","ýer tudana bilen gaýmak","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["cake","/keɪk/","N","tort, köke","торт, пирожное","a sweet food made with flour and sugar","a birthday cake.","doglan gün torty","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["ice cream","/ˌaɪs ˈkriːm/","N","dondurma","мороженое","a soft frozen sweet food","chocolate ice cream.","şokoladly dondurma","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["biscuits","/ˈbɪskɪts/","N","peşenýe","печенье","small flat sweet cakes","tea and biscuits.","çaý bilen peşenýe","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["crisps","/krɪsps/","N","çips","чипсы","thin slices of fried potato","a packet of crisps.","bir bukja çips","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["nuts","/nʌts/","N","hozy","орехи","hard-shelled things you eat","salted nuts.","duzly hoz","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["sandwich","/ˈsænwɪdʒ/","N","sendwiç","сэндвич","two slices of bread with food between","a cheese sandwich.","peýnirli sendwiç","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["sweets","/swiːts/","N","konfet","конфеты","small soft sweet foods","a bag of sweets.","bir bukja konfet","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["takeaway","/ˈteɪkəweɪ/","N","taýawan (öýe iýmit)","еда навынос","hot food you buy cooked to eat at home (British English)","We ordered some takeaway salads.","Biz biraz taýawan salat sargyt etdik.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["bottle","/ˈbɒtl/","N","çüýşe","бутылка","a container with a narrow neck for liquids","a bottle of water.","bir çüýşe suw","A1","Oxford 3000","—","a bottle of","New",[{"book":"ele","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["box","/bɒks/","N","guty","коробка","a container with flat sides","a box of chocolates.","bir guty şokolad","A1","Oxford 3000","—","a box of","New",[{"book":"ele","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["carton","/ˈkɑːtn/","N","kagyz gap","пакет, картонная упаковка","a light container for drinks","a carton of juice.","bir gap şire","B1","Oxford 5000","—","a carton of","New",[{"book":"ele","unit":9,"lesson":"9B","page":72,"section":"vocabulary"},{"book":"intp","unit":4,"lesson":"4A","page":36,"section":"vocabulary_bank"}]],["jar","/dʒɑː/","N","banka (aýna)","банка (стеклянная)","a glass container with a lid","a jar of jam.","bir banka mürebbä","A2","Oxford 3000","—","a jar of","New",[{"book":"ele","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["packet","/ˈpækɪt/","N","bukja","пачка","a small paper or plastic container","a packet of crisps.","bir bukja çips","A2","Oxford 3000","—","a packet of","New",[{"book":"ele","unit":9,"lesson":"9B","page":72,"section":"vocabulary"},{"book":"intp","unit":4,"lesson":"4A","page":36,"section":"vocabulary_bank"}]],["tin","/tɪn/","N","konserw bankasy","жестяная банка","a metal container for food","a tin of tomatoes.","bir banka pomidor","B1","Oxford 5000","—","a tin of","New",[{"book":"ele","unit":9,"lesson":"9B","page":72,"section":"vocabulary"},{"book":"intp","unit":4,"lesson":"4A","page":36,"section":"vocabulary_bank"}]],["some","/sʌm/","DET","biraz","немного","an amount of something","I need some milk.","Biraz süýt gerek.","A1","Oxford 3000","—","some milk","New",[{"book":"ele","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["any","/ˈeni/","DET","hiç, islendik","какой-нибудь","used in questions and negatives","We don't have any bread.","Çöregimiz ýok.","A1","Oxford 3000","—","any bread","New",[{"book":"ele","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["much","/mʌtʃ/","DET","köp","много","a large amount","How much sugar do you want?","Näçe şeker isleýärsiň?","A1","Oxford 3000","—","how much","New",[{"book":"ele","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["many","/ˈmeni/","DET","köp (sanalýan)","много (исчисляемое)","a large number","How many eggs do we need?","Näçe ýumurtga gerek?","A1","Oxford 3000","—","how many","New",[{"book":"ele","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["a lot of","/ə lɒt əv/","DET","köp","много","a large amount or number","a lot of friends.","köp dost","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["a few","/ə fjuː/","DET","birnäçe","несколько","a small number","a few minutes.","birnäçe minut","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["a little","/ə ˈlɪtl/","DET","biraz","немного","a small amount","a little sugar.","biraz şeker","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9B","page":72,"section":"vocabulary"},{"book":"pre","unit":6,"lesson":"6C","page":50,"section":"vocabulary"}]],["dark chocolate","/ˌdɑːk ˈtʃɒklət/","N","gara şokolad","тёмный шоколад","chocolate with a lot of cocoa and little milk","Dark chocolate has less sugar.","Gara şokoladda şeker az.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["white bread","/ˌwaɪt ˈbred/","N","ak çörek","белый хлеб","bread made from white flour","White bread is soft.","Ak çörek ýumşak bolýar.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["olive oil","/ˌɒlɪv ˈɔɪl/","N","zeýtun ýagy","оливковое масло","oil from olives, used in cooking","Cook the vegetables in olive oil.","Gök önümleri zeýtun ýagynda bişiriň.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["population","/ˌpɒpjuˈleɪʃn/","N","ilaty","население","all the people living in a place","The population is 67 million.","Ilaty 67 million.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9C","page":74,"section":"vocabulary"},{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"},{"book":"advp","unit":5,"lesson":"5B","section":"vocabulary"}]],["kilometre","/ˈkɪləmiːtə/","N","kilometr","километр","a unit of length equal to 1,000 metres","It is 2,500 km away.","2500 km uzaklykda.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9C","page":74,"section":"vocabulary"}]],["metre","/ˈmiːtə/","N","metr","метр","a unit of length equal to 100 centimetres","The wall is two metres high.","Diwar iki metr beýiklikde.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9C","page":74,"section":"vocabulary"}]],["percent","/pəˈsent/","ADV","göterim","процент","one part in every hundred","Fifty percent agreed.","Elli göterimi razy boldy.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9C","page":74,"section":"vocabulary"}]],["half","/hɑːf/","N","ýarym","половина","one of two equal parts","Half of them came.","Ýarymy geldi.","A2","Oxford 3000","—","half of","New",[{"book":"ele","unit":9,"lesson":"9C","page":74,"section":"vocabulary"},{"book":"pre","unit":5,"lesson":"5A","page":38,"section":"vocabulary"}]],["double","/ˈdʌbl/","ADJ","iki esse","двойной","twice as much","double the price.","iki esse baha","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9C","page":74,"section":"vocabulary"},{"book":"pre","unit":5,"lesson":"5A","page":38,"section":"vocabulary"}]],["score","/skɔː/","N","hasap, bal","счёт","the number of points in a game","The score was two to one.","Hasap iki bir boldy.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":9,"lesson":"9C","page":74,"section":"vocabulary"},{"book":"int","unit":5,"lesson":"5A","page":46,"section":"vocabulary_bank"},{"book":"intp","unit":10,"lesson":"10B","page":100,"section":"vocabulary"}]],["average","/ˈævərɪdʒ/","N","ortaça","среднее","the usual amount","the average temperature.","ortaça temperatura","B1","Oxford 5000","—","on average","New",[{"book":"ele","unit":9,"lesson":"9C","page":74,"section":"vocabulary"}]],["total","/ˈtəʊtl/","N","jemi","итого","the whole amount","The total is forty.","Jemi kyrk.","A2","Oxford 3000","—","in total","New",[{"book":"ele","unit":9,"lesson":"9C","page":74,"section":"vocabulary"}]],["the lift","/ðə lɪft/","N","lift","лифт","a machine that carries people up and down","Take the lift to the third floor.","Üçünji gata lift bilen çykyň.","A2","Oxford 3000","—","take the lift","New",[{"book":"ele","unit":13,"lesson":"PE1","page":12,"section":"practical_english"}]],["a double room","/ə ˈdʌbl ruːm/","N","iki adamlyk otag","двухместный номер","a hotel room with a big bed for two","We booked a double room.","Iki adamlyk otag aldyk.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE1","page":12,"section":"practical_english"}]],["a single room","/ə ˈsɪŋɡl ruːm/","N","bir adamlyk otag","одноместный номер","a hotel room for one person","A single room, please.","Bir adamlyk otag, haýyş.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE1","page":12,"section":"practical_english"}]],["the ground floor","/ðə ɡraʊnd flɔː/","N","zemini gat","первый этаж","the floor at street level","Breakfast is on the ground floor.","Ertirlik zemini gatda.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE1","page":12,"section":"practical_english"}]],["check in","/tʃek ɪn/","PHR","hasaba durmak","заселиться","to arrive and register at a hotel","We checked in at nine.","Sagat dokuzda hasaba durduk.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE1","page":12,"section":"practical_english"},{"book":"pre","unit":3,"lesson":"3A","page":22,"section":"vocabulary"},{"book":"upp","unit":3,"lesson":"3A","section":"vocabulary_bank"}]],["check out","/tʃek aʊt/","PHR","hasapdan çykmak","выселиться","to leave a hotel and pay","We checked out early.","Ir hasapdan çykdym.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE1","page":12,"section":"practical_english"}]],["reservation","/ˌrezəˈveɪʃn/","N","öňünden alyş","бронь","an arrangement to keep a room","I have a reservation.","Öňünden alyşym bar.","A2","Oxford 3000","—","make a reservation","New",[{"book":"ele","unit":13,"lesson":"PE1","page":12,"section":"practical_english"},{"book":"pre","unit":13,"lesson":"PE1","page":12,"section":"practical_english"},{"book":"intp","unit":6,"lesson":"6A","page":56,"section":"vocabulary_bank"}]],["espresso","/ˈesprəʊ/","N","espresso","эспрессо","a small strong coffee","an espresso, please.","bir espresso, haýyş","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE2","page":28,"section":"practical_english"}]],["americano","/əˌmerɪˈkɑːnəʊ/","N","amerikano","американо","a coffee made weaker with water","a regular americano.","adaty amerikano","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE2","page":28,"section":"practical_english"}]],["latte","/ˈlæteɪ/","N","latte","латте","a coffee with a lot of milk","a large latte.","uly latte","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE2","page":28,"section":"practical_english"}]],["cappuccino","/ˌkæpuˈtʃiːnəʊ/","N","kappuçino","капучино","a coffee with hot milk and foam","a double cappuccino.","iki esse kappuçino","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE2","page":28,"section":"practical_english"}]],["brownie","/ˈbraʊni/","N","şokoladly köke","брауни","a small square chocolate cake","a chocolate brownie.","şokoladly köke","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE2","page":28,"section":"practical_english"}]],["croissant","/ˈkrwæsɒŋ/","N","kruassan","круассан","a curved bread roll made with butter","a fresh croissant.","täze kruassan","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE2","page":28,"section":"practical_english"}]],["take away","/teɪk əˈweɪ/","PHR","ýanyň bilen almak","на вынос","food or drink you take with you","A coffee to take away.","Ýanym bilen bir kofe.","A2","Oxford 3000","—","to take away","New",[{"book":"ele","unit":13,"lesson":"PE2","page":28,"section":"practical_english"},{"book":"intp","unit":7,"lesson":"7A","page":66,"section":"vocabulary_bank"}]],["for here","/fə hɪə/","PHR","şu ýerde","здесь (в кафе)","eaten or drunk where you buy it","For here or to take away?","Şu ýerdemi ýa-da ýanyňyz bilen?","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE2","page":28,"section":"practical_english"}]],["single","/ˈsɪŋɡl/","ADJ","ýeke (espresso)","одинарный","only one espresso","A single espresso, please.","Bir ýeke espresso, haýyş.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE2","page":28,"section":"practical_english"},{"book":"int","unit":5,"lesson":"5B","page":50,"section":"vocabulary_bank"},{"book":"upp","unit":6,"lesson":"6B","section":"vocabulary"}]],["regular","/ˈreɡjələ/","ADJ","adaty ölçeg","обычный размер","normal size (American English)","A regular latte, please.","Adaty ölçegli latte, haýyş.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE2","page":28,"section":"practical_english"}]],["large","/lɑːdʒ/","ADJ","uly","большой","big size","A large cappuccino, please.","Uly kapuçino, haýyş.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE2","page":28,"section":"practical_english"}]],["anything else","/ˌeniθɪŋ ˈels/","PHR","başga zat?","что-нибудь ещё?","what a seller asks when you may want more","Anything else? No, thanks.","Başga zat? Ýok, sag boluň.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE2","page":28,"section":"practical_english"}]],["How much is it?","/haʊ mʌtʃ ɪz ɪt/","PHR","bahasy näçe?","сколько это стоит?","used to ask the price","How much is it? Twenty pounds.","Bahasy näçe? Iýirmi funt.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE3","page":44,"section":"practical_english"}]],["I'm looking for...","/aɪm ˈlʊkɪŋ fɔː/","PHR","... gözleýärin","я ищу...","used to say what you want to buy","I'm looking for a shirt.","Köýnek gözleýärin.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE3","page":44,"section":"practical_english"},{"book":"upp","unit":11,"lesson":"CE1","section":"vocabulary"}]],["Do you have this in...?","/du ju hæv ðɪs ɪn/","PHR","munuň ... bar?","у вас есть это в...?","used to ask for another size or colour","Do you have this in blue?","Munuň gögi barmy?","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE3","page":44,"section":"practical_english"}]],["It doesn't fit","/ɪt dʌznt fɪt/","PHR","bolanok, ölçegi gelenok","не подходит по размеру","used when clothes are the wrong size","It doesn't fit. Have you got a larger one?","Ölçegi gelenok. Ulysy barmy?","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE3","page":44,"section":"practical_english"}]],["fitting room","/ˈfɪtɪŋ ruːm/","N","synag otagy","примерочная","a room where you try on clothes","The fitting room is over there.","Synag otagy aňyrda.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE3","page":44,"section":"practical_english"}]],["I'm sorry","/aɪm ˈsɒri/","PHR","bagyşlaň","извините","used to apologize","I'm really sorry.","Hakykatdan bagyşlaň.","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE3","page":44,"section":"practical_english"}]],["Don't worry","/dəʊnt ˈwʌri/","PHR","alada etme","не беспокойтесь","used to tell someone not to be upset","Don't worry. No problem.","Alada etme. Mesele ýok.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE3","page":44,"section":"practical_english"}]],["size","/saɪz/","N","ölçeg","размер","how big or small something is","What size are you?","Ölçegiňiz näçe?","A2","Oxford 3000","—","in size","New",[{"book":"ele","unit":13,"lesson":"PE3","page":44,"section":"vocabulary"},{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"},{"book":"upp","unit":2,"lesson":"2B","section":"vocabulary_bank"},{"book":"intp","unit":11,"lesson":"PE1","page":14,"section":"practical_english"}]],["try on","/traɪ ɒn/","PHR","synap görmek","примерить","to put on clothes to see if they fit","Can I try it on?","Synap görüp bilerinmi?","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE3","page":44,"section":"vocabulary"},{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"},{"book":"upp","unit":2,"lesson":"2B","section":"vocabulary_bank"},{"book":"intp","unit":7,"lesson":"7A","page":66,"section":"vocabulary_bank"}]],["on the corner","/ɒn ðə ˈkɔːnə/","PHR","burçda","на углу","where two streets meet","The bank is on the corner.","Bank burçda.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE4","page":60,"section":"practical_english"}]],["at the traffic lights","/ət ðə ˈtræfɪk laɪts/","PHR","çyra ýanýan ýerde","на светофоре","where the road signals are","Turn right at the traffic lights.","Çyra ýanýan ýerde saga öwrüliň.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE4","page":60,"section":"practical_english"}]],["go past","/ɡəʊ pɑːst/","PHR","ýanyndan geçiň","пройти мимо","to go by something without stopping","Go past the church.","Buthananyň ýanyndan geçiň.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE4","page":60,"section":"practical_english"}]],["at the end of the street","/ət ði end əv ðə striːt/","PHR","köçäniň ahyrynda","в конце улицы","at the furthest point of a street","It is at the end of the street.","Köçäniň ahyrynda.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE4","page":60,"section":"practical_english"}]],["Excuse me, where is","/ɪkˈskjuːz miː weər ɪz/","PHR","bagyşlaň, ... nirede?","извините, где...?","used to ask a stranger where a place is","Excuse me, where is the station?","Bagyşlaň, menzil nirede?","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE4","page":60,"section":"practical_english"}]],["starter","/ˈstɑːtə/","N","başlangyç tagam","закуска","a small dish eaten before the main one","soup as a starter.","başlangyç hökmünde çorba","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE5","page":76,"section":"practical_english"},{"book":"pre","unit":13,"lesson":"PE2","page":28,"section":"practical_english"},{"book":"intp","unit":6,"lesson":"6A","page":56,"section":"vocabulary_bank"}]],["main course","/meɪn kɔːs/","N","esasy tagam","основное блюдо","the largest dish of a meal","chicken as a main course.","esasy tagam hökmünde towuk","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE5","page":76,"section":"practical_english"},{"book":"pre","unit":13,"lesson":"PE2","page":28,"section":"practical_english"},{"book":"intp","unit":6,"lesson":"6A","page":56,"section":"vocabulary_bank"}]],["dessert","/dɪˈzɜːt/","N","süýji tagam","десерт","sweet food eaten at the end of a meal","What is there for dessert?","Süýji tagam näme bar?","A2","Oxford 3000","—","for dessert","New",[{"book":"ele","unit":13,"lesson":"PE5","page":76,"section":"practical_english"},{"book":"pre","unit":13,"lesson":"PE2","page":28,"section":"practical_english"},{"book":"intp","unit":6,"lesson":"6A","page":56,"section":"vocabulary_bank"}]],["menu","/ˈmenjuː/","N","menýu","меню","a list of the food a restaurant serves","Can I see the menu?","Menýuny görüp bilerinmi?","A1","Oxford 3000","—","see the menu","New",[{"book":"ele","unit":13,"lesson":"PE5","page":76,"section":"practical_english"},{"book":"intp","unit":6,"lesson":"6A","page":56,"section":"vocabulary_bank"}]],["tip","/tɪp/","N","çaý pul","чаевые","extra money you leave for the waiter","Leave a small tip.","Kiçi çaý pul goýuň.","A2","Oxford 3000","—","leave a tip","New",[{"book":"ele","unit":13,"lesson":"PE5","page":76,"section":"practical_english"},{"book":"pre","unit":13,"lesson":"PE2","page":28,"section":"practical_english"},{"book":"intp","unit":6,"lesson":"6A","page":56,"section":"vocabulary_bank"}]],["order","/ˈɔːdə/","V","sargyt etmek","заказывать","to ask for food in a restaurant","We ordered fish.","Balyk sargyt etdik.","A2","Oxford 3000","—","order a meal","New",[{"book":"ele","unit":13,"lesson":"PE5","page":76,"section":"practical_english"},{"book":"pre","unit":13,"lesson":"PE2","page":28,"section":"practical_english"},{"book":"intp","unit":6,"lesson":"6A","page":56,"section":"vocabulary_bank"}]],["soup","/suːp/","N","çorba","суп","a hot liquid meal","onion soup.","sogan çorbasy","A1","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE5","page":76,"section":"practical_english"}]],["grilled","/ɡrɪld/","ADJ","grillenen","жареный на гриле","cooked over a fire or hot surface","grilled chicken.","grillenen towuk","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE5","page":76,"section":"practical_english"}]],["security","/sɪˈkjʊərəti/","N","howpsuzlyk barlagy","контроль безопасности","the place where bags are checked at an airport","Go through security.","Howpsuzlyk barlagyndan geçiň.","A2","Oxford 3000","—","go through security","New",[{"book":"ele","unit":13,"lesson":"PE6","page":92,"section":"practical_english"},{"book":"pre","unit":3,"lesson":"3A","page":22,"section":"vocabulary"}]],["departure lounge","/dɪˈpɑːtʃə laʊndʒ/","N","uçuş zaly","зал ожидания","the area where you wait for a flight","Wait in the departure lounge.","Uçuş zalynda garaşyň.","B1","Oxford 5000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE6","page":92,"section":"practical_english"}]],["gate","/ɡeɪt/","N","gapy","выход на посадку","the place where you get on a plane","Go to gate twelve.","On ikinji gapa baryň.","A2","Oxford 3000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE6","page":92,"section":"practical_english"},{"book":"pre","unit":3,"lesson":"3A","page":22,"section":"vocabulary"},{"book":"int","unit":7,"lesson":"7B","page":70,"section":"vocabulary_bank"},{"book":"upp","unit":3,"lesson":"3A","section":"vocabulary_bank"},{"book":"intp","unit":5,"lesson":"5B","page":50,"section":"vocabulary_bank"}]],["taxi rank","/ˈtæksi ræŋk/","N","taksi duralgasy","стоянка такси","a place where taxis wait for people","Take a taxi from the rank.","Duralgadan taksi tutuň.","B1","Oxford 5000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE6","page":92,"section":"practical_english"},{"book":"int","unit":3,"lesson":"3A","page":26,"section":"vocabulary_bank"}]],["cab","/kæb/","N","taksi","такси","another word for a taxi","I called a cab.","Taksi çagyrdym.","A2","Oxford 3000","—","call a cab","New",[{"book":"ele","unit":13,"lesson":"PE6","page":92,"section":"practical_english"}]],["coach","/kəʊtʃ/","N","uly awtobus","автобус (междугородный)","a large bus for long journeys","The coach leaves at eight.","Uly awtobus sagat sekizde gidýär.","B1","Oxford 5000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE6","page":92,"section":"practical_english"},{"book":"pre","unit":2,"lesson":"2A","page":14,"section":"vocabulary_bank"},{"book":"int","unit":3,"lesson":"3A","page":26,"section":"vocabulary_bank"}]],["the Tube","/ðə tjuːb/","N","London metrosy","лондонское метро","the underground railway in London","Take the Tube to the airport.","Howa menziline metro bilen gidiň.","B1","Oxford 5000","—","—","New",[{"book":"ele","unit":13,"lesson":"PE6","page":92,"section":"practical_english"}]],["do your homework","/duː jə ˈhəʊmwɜːk/","PHR","öý işini etmek","делать домашнее задание","to complete the work a teacher gives","Have you done your homework?","Öý işiňi etdiňmi?","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1A","page":6,"section":"vocabulary"}]],["make a mistake","/meɪk ə mɪˈsteɪk/","PHR","ýalňyşmak","ошибаться","to do something wrong","Don't be afraid to make a mistake.","Ýalňyşmakdan gorkma.","A2","Oxford 3000","—","make a mistake","New",[{"book":"pre","unit":1,"lesson":"1A","page":6,"section":"vocabulary"}]],["go online","/ɡəʊ ˌɒnˈlaɪn/","PHR","onlaýn girmek","выходить в интернет","to use the internet","He goes online after dinner.","Agşam naharyndan soň onlaýn girýär.","A1","Oxford 3000","—","go online","New",[{"book":"pre","unit":1,"lesson":"1A","page":6,"section":"vocabulary"}]],["do exercise","/duː ˈeksəsaɪz/","PHR","maşk etmek","делать упражнения","to train your body","I do exercise three times a week.","Hepdede üç gezek maşk edýärin.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1A","page":6,"section":"vocabulary"}]],["have fun","/hæv fʌn/","PHR","keýp etmek","веселиться","to enjoy yourself","We had fun at the party.","Toýda keýp etdik.","A1","Oxford 3000","—","have fun","New",[{"book":"pre","unit":1,"lesson":"1A","page":6,"section":"vocabulary"}]],["capital letter","/ˈkæpɪtl ˈletə(r)/","N","baş harp","заглавная буква","a big letter, e.g. A not a","Start the sentence with a capital letter.","Sözlemi baş harp bilen başla.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1A","page":6,"section":"vocabulary"}]],["punctuation","/ˌpʌŋktʃuˈeɪʃn/","N","durk bellikleri","пунктуация","marks like full stops and commas","Check your spelling and punctuation.","Ýazuwyňy we durk belliklerini barla.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":1,"lesson":"1A","page":6,"section":"vocabulary"}]],["clever","/ˈklevə(r)/","ADJ","akylly","умный","quick at learning and understanding things","She is the cleverest student in the class.","Ol sinipdagi iň akylly okuwçy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["friendly","/ˈfrendli/","ADJ","dostlukly","дружелюбный","open and warm towards other people","The people here are very friendly.","Bu ýerdäki adamlar gaty dostlukly.","A1","Oxford 3000","—","a friendly smile","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["funny","/ˈfʌni/","ADJ","gülmeli","смешной","making people laugh","He told us a funny story.","Ol bize gülmeli hekaýa gürrüň berdi.","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["generous","/ˈdʒenərəs/","ADJ","jomart","щедрый","happy to give people things","She is generous with her time.","Ol wagty bilen jomart.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"},{"book":"advp","unit":7,"lesson":"7B","section":"vocabulary"}]],["kind","/kaɪnd/","ADJ","mähirli","добрый","friendly and good to other people","It was kind of you to help.","Kömek etmegiňiz mähirli boldy.","A2","Oxford 3000","—","a kind person","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["lazy","/ˈleɪzi/","ADJ","ýalta","ленивый","not wanting to work or use energy","My lazy brother never makes his bed.","Ýalta doganym hiç wagt düşegini ýygnamaýar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["shy","/ʃaɪ/","ADJ","uyaljaň","застенчивый","unable to talk easily to people you don't know","She is too shy to speak in public.","Ol köpçülikde gürlemäge gaty uyaljaň.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"},{"book":"adv","unit":1,"lesson":"1A","section":"vocabulary_bank"}]],["talkative","/ˈtɔːkətɪv/","ADJ","gepleýji","разговорчивый","talking a lot","Our new neighbour is very talkative.","Täze goňşumyz gaty gepleýji.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["extrovert","/ˈekstrəvɜːt/","ADJ","ekstrawert","экстраверт","lively and confident with other people","He is an extrovert who loves parties.","Ol toýlary söýýän ekstrawert.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["hard-working","/ˌhɑːd ˈwɜːkɪŋ/","ADJ","zähmetsöýer","трудолюбивый","putting a lot of effort into work","She is a hard-working nurse.","Ol zähmetsöýer şepagat uýasy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"},{"book":"adv","unit":6,"lesson":"6A","section":"vocabulary"}]],["mean","/miːn/","ADJ","gysganç","скупой","not wanting to spend money or give things","He is too mean to buy a present.","Ol sowgat almaga gaty gysganç.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"},{"book":"adv","unit":1,"lesson":"1A","section":"vocabulary_bank"}]],["serious","/ˈsɪəriəs/","ADJ","çynlakaý","серьёзный","thinking carefully; not joking","She gave me a serious look.","Ol maňa çynlakaý seretdi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["stupid","/ˈstjuːpɪd/","ADJ","ahmak","глупый","not showing intelligence; a bad idea","That was a stupid mistake.","Ol ahmak ýalňyşlykdy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["unfriendly","/ʌnˈfrendli/","ADJ","dostlukly däl","недружелюбный","not friendly","The waiter was cold and unfriendly.","Ofisiant sowuk we dostlukly däldi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["unkind","/ˌʌnˈkaɪnd/","ADJ","mähirsiz","недобрый","not kind","It was unkind to laugh at him.","Oňa gülmek mähirsiz boldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["curly","/ˈkɜːli/","ADJ","buýra","кудрявый","having curls; not straight","She has curly red hair.","Onuň buýra gyzyl saçlary bar.","A2","Oxford 3000","—","curly hair","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["straight","/streɪt/","ADJ","göni","прямой","not curly or bent","He has long straight hair.","Onuň uzyn göni saçlary bar.","A2","Oxford 3000","—","straight hair","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["beard","/bɪəd/","N","sakgal","борода","hair on the chin and cheeks of a man","He has a beard and a moustache.","Onuň sakgaly we murtlary bar.","A2","Oxford 3000","—","grow a beard","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["bald","/bɔːld/","ADJ","kel","лысый","having no hair on the head","My dad started going bald at thirty.","Kakam otuz ýaşynda kel bolup başlady.","A2","Oxford 3000","—","go bald","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["thin","/θɪn/","ADJ","ýuka","худой","having little fat on the body","She was tall and very thin.","Ol uzyn boýly we gaty ýukady.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["slim","/slɪm/","ADJ","ýiti","стройный","thin in an attractive way","He stayed slim by running every day.","Ol her gün ylgap ýiti galdy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["overweight","/ˌəʊvəˈweɪt/","ADJ","agramly","с лишним весом","too fat; more polite than \"fat\"","The doctor says I am a bit overweight.","Lukman biraz agramlydygymy aýdýar.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"},{"book":"upp","unit":9,"lesson":"9B","section":"wordbuilding"}]],["attractive","/əˈtræktɪv/","ADJ","özüne çekiji","привлекательный","pleasant or beautiful to look at","She has an attractive smile.","Onuň özüne çekiji ýylgyryşy bar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["height","/haɪt/","N","boý","рост","how tall a person or thing is","He's medium height and very slim.","Ol orta boýly we gaty ýiti.","A2","Oxford 3000","—","medium height","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["blonde","/blɒnd/","ADJ","sary saçly","блондин, светловолосый","with light yellow hair","She has long blonde hair.","Onuň uzyn sary saçy bar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["dark","/dɑːk/","ADJ","goýy","тёмный","not light in colour","He has dark hair and brown eyes.","Onuň goýy saçy we goňur gözleri bar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"},{"book":"intp","unit":1,"lesson":"1B","page":10,"section":"vocabulary_bank"}]],["medium-height","/ˌmiːdiəm ˈhaɪt/","ADJ","orta boýly","среднего роста","neither tall nor short","He's medium-height and slim.","Ol orta boýly we ýuka.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["enthusiastic","/ɪnˌθjuːziˈæstɪk/","ADJ","joşgunly","увлечённый, энтузиастичный","very interested and excited about something","She is enthusiastic about her new job.","Ol täze işi barada joşgunly.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"}]],["blouse","/blaʊz/","N","bluzka","блузка","a shirt for women and girls","She wore a white silk blouse.","Ol ak ýüpek bluzka geýdi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"}]],["cardigan","/ˈkɑːdɪɡən/","N","kofta","кофта","a warm sweater with buttons at the front","Put on a cardigan, it is cold.","Kofta geý, howa sowuk.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"}]],["glove","/ɡlʌv/","N","ellik","перчатка","a piece of clothing for the hand","I lost one of my gloves.","Elliklerimiň birini ýitirdim.","A2","Oxford 3000","—","a pair of gloves","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"}]],["scarf","/skɑːf/","N","şarf","шарф","a piece of cloth worn round the neck","He wrapped a warm scarf round his neck.","Ol boýnuna ýyly şarf dolady.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"}]],["tie","/taɪ/","N","galstuk","галстук","a narrow piece of cloth worn round the neck with a shirt","My father always wears a tie.","Kakam hemişe galstuk dakynýar.","A2","Oxford 3000","—","wear a tie","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"}]],["tracksuit","/ˈtræksuːt/","N","sport kostýumy","спортивный костюм","loose clothes worn for sport or relaxing","He changed into a tracksuit.","Ol sport kostýumyny geýdi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"},{"book":"upp","unit":2,"lesson":"2B","section":"vocabulary_bank"}]],["underwear","/ˈʌndəweə(r)/","N","içki geýim","нижнее бельё","clothes worn under other clothes","Pack some clean underwear.","Arassa içki geýim ýygnap goý.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"},{"book":"adv","unit":7,"lesson":"7A","section":"vocabulary_bank"},{"book":"intp","unit":2,"lesson":"2A","page":16,"section":"vocabulary_bank"}]],["on the left","/ɒn ðə left/","PHR","çepde","слева","at or towards the left side","The exit is on the left.","Çykalga çepde.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"}]],["on the right","/ɒn ðə raɪt/","PHR","sagda","справа","at or towards the right side","Take the door on the right.","Sagdaky gapyny saýla.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"}]],["belt","/belt/","N","kemer","ремень","a strip of leather you wear round your waist","He wears a black belt.","Ol gara kemer dakynýar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"}]],["boots","/buːts/","N","ädik","ботинки, сапоги","strong shoes that cover your feet and ankles","Put on your boots, it is snowing.","Ädikleriňi geý, gar ýagýar.","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"}]],["bracelet","/ˈbreɪslət/","N","bilezik","браслет","jewellery you wear round your wrist","She wears a gold bracelet.","Ol altyn bilezik dakynýar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"}]],["earrings","/ˈɪərɪŋz/","N","gulakhalka","серьги","jewellery you wear on your ears","Her earrings are silver.","Onuň gulakhalkalary kümüş.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"}]],["gloves","/ɡlʌvz/","N","ellik","перчатки","clothes you wear on your hands","Wear gloves, your hands are cold.","Ellik geý, elleriň üşeýär.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"}]],["jumper","/ˈdʒʌmpə/","N","jemper","джемпер, пуловер","a warm piece of clothing for the top of your body (British English)","Put on a jumper, it is cold.","Jemper geý, sowuk.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"},{"book":"intp","unit":10,"lesson":"10A","page":96,"section":"vocabulary"}]],["leggings","/ˈleɡɪŋz/","N","legins","легинсы","very tight trousers worn by women","She wears black leggings.","Ol gara legins geýýär.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"}]],["necklace","/ˈnekləs/","N","monjuk","ожерелье","jewellery you wear round your neck","What a beautiful necklace!","Nähili owadan monjuk!","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"}]],["sandals","/ˈsændlz/","N","sandal","сандалии","light shoes for warm weather","I wear sandals in summer.","Tomusda sandal geýýärin.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"}]],["tights","/taɪts/","N","kalgotki","колготки","thin clothes that cover women's legs","She wears black tights in winter.","Gyşda gara kalgotki geýýär.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"}]],["top","/tɒp/","N","bluzka","топ, кофточка","light clothes for the top of your body","That is a nice top.","Bu owadan bluzka.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"}]],["flip-flops","/ˈflɪp flɒps/","N","şypbyk","шлёпанцы, вьетнамки","very light shoes you wear in summer","We wear flip-flops on the beach.","Kenarda şypbyk geýýäris.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"},{"book":"intp","unit":2,"lesson":"2A","page":16,"section":"vocabulary_bank"}]],["pyjamas","/pəˈdʒɑːməz/","N","pijama","пижама","clothes you wear in bed","I sleep in cotton pyjamas.","Pagta pijamada ýatýaryn.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":1,"lesson":"1C","page":10,"section":"vocabulary_bank"},{"book":"intp","unit":2,"lesson":"2A","page":16,"section":"vocabulary_bank"}]],["camping","/ˈkæmpɪŋ/","N","düşelge","кемпинг","sleeping outside in a tent","We went camping in the mountains.","Biz daglarda düşelge gurduk.","A2","Oxford 3000","—","go camping","New",[{"book":"pre","unit":2,"lesson":"2A","page":14,"section":"vocabulary_bank"}]],["cruise","/kruːz/","N","kruiz","круиз","a holiday travelling on a large ship","They went on a Mediterranean cruise.","Olar Ortaýer deňzi kruizine gitdiler.","B1","Oxford 5000","—","go on a cruise","New",[{"book":"pre","unit":2,"lesson":"2A","page":14,"section":"vocabulary_bank"}]],["guest house","/ˈɡest haʊs/","N","myhman öýi","гостевой дом","a small cheap place to stay, like a home","We stayed in a little guest house.","Kiçijik myhman öýünde galdyk.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":2,"lesson":"2A","page":14,"section":"vocabulary_bank"}]],["scenery","/ˈsiːnəri/","N","tebigy gözellik","пейзаж","the natural features of a place","The mountain scenery was beautiful.","Dag tebigaty örän owadandy.","B1","Oxford 5000","—","beautiful scenery","New",[{"book":"pre","unit":2,"lesson":"2A","page":14,"section":"vocabulary_bank"}]],["sightseeing","/ˈsaɪtsiːɪŋ/","N","görmeli ýerlere gezelenç","осмотр достопримечательностей","visiting interesting places","We spent the day sightseeing.","Güni gözel ýerlere gezelenç edip geçirdik.","A2","Oxford 3000","—","go sightseeing","New",[{"book":"pre","unit":2,"lesson":"2A","page":14,"section":"vocabulary_bank"},{"book":"adv","unit":8,"lesson":"8B","section":"vocabulary_bank"}]],["tent","/tent/","N","çadyr","палатка","a cloth shelter you sleep in","We put up the tent by the river.","Çadyry derýanyň ýanynda gurdyk.","A2","Oxford 3000","—","put up a tent","New",[{"book":"pre","unit":2,"lesson":"2A","page":14,"section":"vocabulary_bank"}]],["tour","/tʊə(r)/","N","tur","тур","a short visit to look round a place","We took a tour of the old city.","Köne şähere tur etdik.","A2","Oxford 3000","—","a guided tour","New",[{"book":"pre","unit":2,"lesson":"2A","page":14,"section":"vocabulary_bank"}]],["voyage","/ˈvɔɪɪdʒ/","N","deňiz syýahaty","морское путешествие","a long journey by sea or in space","The voyage across the ocean took a month.","Okean syýahaty bir aý dowam etdi.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":2,"lesson":"2A","page":14,"section":"vocabulary_bank"}]],["delayed","/dɪˈleɪd/","ADJ","giçikdirilen","задержанный","later than planned","Our flight was delayed by two hours.","Uçarymyz iki sagat giçikdirildi.","A2","Oxford 3000","—","a delayed flight","New",[{"book":"pre","unit":2,"lesson":"2A","page":14,"section":"vocabulary_bank"}]],["hire","/ˈhaɪə/","V","kärendesine almak","брать напрокат","to pay to use something for a short time","We hired a bike for the day.","Günlük welosiped kärendesine aldyk.","A2","Oxford 3000","—","hire a car","New",[{"book":"pre","unit":2,"lesson":"2A","page":14,"section":"vocabulary_bank"}]],["sunbathe","/ˈsʌnbeɪð/","V","güne düşmek","загорать","to sit or lie in the sun","She sunbathed on the beach all morning.","Ol bütin irden kenarda güne düşdi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":2,"lesson":"2A","page":14,"section":"vocabulary_bank"}]],["go abroad","/ˌɡəʊ əˈbrɔːd/","PHR","daşary ýurda gitmek","поехать за границу","to travel to another country","They go abroad every summer.","Olar her tomus daşary ýurda gidýärler.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":2,"lesson":"2A","page":14,"section":"vocabulary_bank"}]],["at night","/æt naɪt/","PHR","gijesine","ночью","during the night","I never drink coffee at night.","Gijesine hiç wagt kofe içmeýärin.","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["in the morning","/ɪn ðə ˈmɔːnɪŋ/","PHR","irden","утром","during the morning","I go running in the morning.","Irden ylgamaga gidýärin.","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["on time","/ɒn taɪm/","PHR","wagtynda","вовремя","at the planned time; not late","The train arrived on time.","Otly wagtynda geldi.","A2","Oxford 3000","—","arrive on time","New",[{"book":"pre","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"},{"book":"adv","unit":5,"lesson":"5A","section":"vocabulary_bank"}]],["in time","/ɪn taɪm/","PHR","wagt ýetişip","успеть вовремя","early enough for something","We got to the airport in time.","Wagtynda aeroporta ýetişdik.","A2","Oxford 3000","—","in time for","New",[{"book":"pre","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"},{"book":"adv","unit":5,"lesson":"5A","section":"vocabulary_bank"}]],["during","/ˈdjʊərɪŋ/","PREP","dowamynda","во время","from the beginning to the end of a period","She fell asleep during the film.","Filmiň dowamynda uklap galdy.","A2","Oxford 3000","—","during the night","New",[{"book":"pre","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["for","/fə(r)/","PREP","dowamynda (wagt)","в течение","used to say how long something lasts","We waited for two hours.","Iki sagat garadyk.","A1","Oxford 3000","—","for ages","New",[{"book":"pre","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["since","/sɪns/","PREP","şondan bäri","с (поры)","from a point in the past until now","She has lived here since 2019.","2019-njy ýyldan bäri şu ýerde ýaşaýar.","A2","Oxford 3000","—","since then","New",[{"book":"pre","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["until","/ənˈtɪl/","PREP","çenli","до (поры)","up to a particular time","The shop is open until nine.","Dükan doquza çenli açyk.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["by","/baɪ/","PREP","çenli (möhlet)","к (сроку)","not later than a time","Finish the report by Friday.","Hasabaty anna güni çenli gutar.","A2","Oxford 3000","—","by the time","New",[{"book":"pre","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["from ... to","/frɒm tuː/","PREP","-dan ... çenli","с ... до","showing the start and end of a period","I work from nine to five.","Dokuzdan bäşe çenli işleýärin.","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["then","/ðen/","ADV","soňra","затем","after that; next","Then add the sugar.","Soňra şeker goş.","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":2,"lesson":"2C","page":18,"section":"vocabulary"}]],["after that","/ˈɑːftə ðæt/","PHR","şondan soň","после этого","following the thing just mentioned","After that, we went home.","Şondan soň öýe gitdik.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":2,"lesson":"2C","page":18,"section":"vocabulary"}]],["eventually","/ɪˈventʃuəli/","ADV","aýagynda","в конце концов","in the end, after a long time","He eventually said yes.","Aýagynda hawa diýdi.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":2,"lesson":"2C","page":18,"section":"vocabulary"}]],["immediately","/ɪˈmiːdiətli/","ADV","derrew","немедленно","at once; without delay","Come home immediately.","Derrew öýe gel.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":2,"lesson":"2C","page":18,"section":"vocabulary"}]],["meanwhile","/ˈmiːnwaɪl/","ADV","şol wagtyň özünde","тем временем","during the same time","I cooked; meanwhile he set the table.","Men bişirdim; şol wagt ol süfra ýazdy.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":2,"lesson":"2C","page":18,"section":"vocabulary"}]],["while","/waɪl/","CONJ","şol wagtda","в то время как","during the time that","She read while he slept.","Ol uklap ýatyrka ol okady.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":2,"lesson":"2C","page":18,"section":"vocabulary"}]],["as soon as","/əz suːn əz/","CONJ","dessine","как только","immediately after something","I called her as soon as I heard.","Eşiden dessine oňa jaň etdim.","A2","Oxford 3000","—","as soon as possible","New",[{"book":"pre","unit":2,"lesson":"2C","page":18,"section":"vocabulary"}]],["at first","/ət fɜːst/","PHR","başda","сначала","at the beginning","At first I was nervous.","Başda tolgunýardym.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":2,"lesson":"2C","page":18,"section":"vocabulary"}]],["in the end","/ɪn ði end/","PHR","soňunda","в итоге","after everything happened","In the end we stayed at home.","Soňunda öýde galdyk.","A2","Oxford 3000","—","in the end","New",[{"book":"pre","unit":2,"lesson":"2C","page":18,"section":"vocabulary"}]],["boarding pass","/ˈbɔːdɪŋ pɑːs/","N","münüş kartasy","посадочный талон","a document that lets you get on a plane","Show your boarding pass at the gate.","Münüş kartany derwezede görkez.","A2","Oxford 3000","—","show your boarding pass","New",[{"book":"pre","unit":3,"lesson":"3A","page":22,"section":"vocabulary"},{"book":"upp","unit":3,"lesson":"3A","section":"vocabulary_bank"}]],["customs","/ˈkʌstəmz/","N","gümrük","таможня","the place where bags are checked at a border","It took an hour to get through customs.","Gümrükden geçmek bir sagat aldy.","A2","Oxford 3000","—","go through customs","New",[{"book":"pre","unit":3,"lesson":"3A","page":22,"section":"vocabulary"},{"book":"upp","unit":3,"lesson":"3A","section":"vocabulary_bank"}]],["departure","/dɪˈpɑːtʃə(r)/","N","ugrama","отправление","a plane leaving; the time it leaves","Check the departure time on the screen.","Ekrandan ugrama wagtyny barla.","A2","Oxford 3000","—","departure time","New",[{"book":"pre","unit":3,"lesson":"3A","page":22,"section":"vocabulary"},{"book":"upp","unit":3,"lesson":"3A","section":"vocabulary_bank"}]],["hand luggage","/ˈhænd lʌɡɪdʒ/","N","el goşy","ручная кладь","a small bag you carry onto a plane","You can take one piece of hand luggage.","Bir el goşuny alyp bilersiňiz.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":3,"lesson":"3A","page":22,"section":"vocabulary"}]],["passport control","/ˈpɑːspɔːt kənˈtrəʊl/","N","pasport gözegçiligi","паспортный контроль","where officials check passports","The queue at passport control was long.","Pasport gözegçiliginde nobat uzyn bolady.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":3,"lesson":"3A","page":22,"section":"vocabulary"}]],["terminal","/ˈtɜːmɪnl/","N","terminal","терминал","a building at an airport","Our flight leaves from Terminal 2.","Uçarymyz 2-nji terminaldan gidýär.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":3,"lesson":"3A","page":22,"section":"vocabulary"}]],["take off","/teɪk ɒf/","PHR","uçmak","взлетать","to leave the ground (plane)","The plane took off on time.","Uçar wagtynda uçdy.","A2","Oxford 3000","—","take off on time","New",[{"book":"pre","unit":3,"lesson":"3A","page":22,"section":"vocabulary"},{"book":"intp","unit":7,"lesson":"7A","page":66,"section":"vocabulary_bank"}]],["land","/lænd/","V","gonmak","приземляться","to come down onto the ground","We landed in Istanbul at noon.","Günortan Stambulda gondyk.","A2","Oxford 3000","—","land safely","New",[{"book":"pre","unit":3,"lesson":"3A","page":22,"section":"vocabulary"}]],["arrivals","/əˈraɪvlz/","N","geliş zaly","зона прибытия","the area where passengers arrive","I waited for her in arrivals.","Ony geliş zalynda garadym.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":3,"lesson":"3A","page":22,"section":"vocabulary"}]],["cancel","/ˈkænsl/","V","ýatyrmak","отменять","to stop something planned","They cancelled the evening flight.","Agşamky uçary ýatyrdylar.","A2","Oxford 3000","—","cancel a flight","New",[{"book":"pre","unit":3,"lesson":"3A","page":22,"section":"vocabulary"}]],["arrive in","/əˈraɪv ɪn/","PHR","gelmek","прибывать в (город)","to reach a city or country","We arrived in London on Friday.","Anna güni Londona geldik.","A2","Oxford 3000","—","arrive in a city","New",[{"book":"pre","unit":3,"lesson":"3B","page":24,"section":"vocabulary"}]],["depend on","/dɪˈpend ɒn/","PHR","bagly bolmak","зависеть от","to be decided by something else","It depends on the weather.","Howa bagly.","A2","Oxford 3000","—","depend on you","New",[{"book":"pre","unit":3,"lesson":"3B","page":24,"section":"vocabulary"}]],["laugh at","/lɑːf æt/","PHR","gülmek","смеяться над","to smile or make sounds because something is funny","Don't laugh at my mistakes.","Ýalňyşlaryma gülme.","A2","Oxford 3000","—","laugh at a joke","New",[{"book":"pre","unit":3,"lesson":"3B","page":24,"section":"vocabulary"}]],["think about","/θɪŋk əˈbaʊt/","PHR","pikirlenmek","думать о","to have something in your mind","I'm thinking about my holiday.","Dynç alyşym barada pikir edýärin.","A2","Oxford 3000","—","think about it","New",[{"book":"pre","unit":3,"lesson":"3B","page":24,"section":"vocabulary"}]],["belong to","/bɪˈlɒŋ tuː/","PHR","degli bolmak","принадлежать","to be the property of someone","This bag belongs to me.","Bu sumka maňa degişli.","A2","Oxford 3000","—","belong to me","New",[{"book":"pre","unit":3,"lesson":"3B","page":24,"section":"vocabulary"}]],["consist of","/kənˈsɪst əv/","PHR","ybarat bolmak","состоять из","to be made of parts","The test consists of three parts.","Synag üç bölümden ybarat.","B1","Oxford 5000","—","consist of parts","New",[{"book":"pre","unit":3,"lesson":"3B","page":24,"section":"vocabulary"}]],["look after","/lʊk ˈɑːftə(r)/","PHR","göz-gulak bolmak","заботиться о","to take care of someone or something","She looks after her little brother.","Kiçi doganyna göz-gulak bolýar.","A2","Oxford 3000","—","look after children","New",[{"book":"pre","unit":3,"lesson":"3B","page":24,"section":"vocabulary"}]],["look forward to","/lʊk ˈfɔːwəd tuː/","PHR","sabyrsyzlyk bilen garaşmak","с нетерпением ждать","to be excited about something coming","I look forward to seeing you.","Görüşmäge sabyrsyzlyk bilen garaşýaryn.","A2","Oxford 3000","—","look forward to meeting","New",[{"book":"pre","unit":3,"lesson":"3B","page":24,"section":"vocabulary"}]],["stay at","/steɪ æt/","PHR","galmak","оставаться в","to live somewhere for a time","We stayed at a small hotel.","Kiçi myhmanhanada galdyk.","A2","Oxford 3000","—","stay at home","New",[{"book":"pre","unit":3,"lesson":"3B","page":24,"section":"vocabulary"}]],["talk about","/tɔːk əˈbaʊt/","PHR","gürleşmek","говорить о","to discuss something","We talked about our plans.","Meýilnamalarymyz barada gürleşdik.","A2","Oxford 3000","—","talk about work","New",[{"book":"pre","unit":3,"lesson":"3B","page":24,"section":"vocabulary"}]],["thing","/θɪŋ/","N","zat","вещь","an object you cannot name","What is that thing on the table?","Stoluň üstündäki ol zat näme?","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":3,"lesson":"3C","page":26,"section":"vocabulary"}]],["stuff","/stʌf/","N","zatlar","вещи, всякое","things, especially when you do not name them","I left my stuff in the car.","Zatlarymy maşynda goýdum.","A2","Oxford 3000","—","all my stuff","New",[{"book":"pre","unit":3,"lesson":"3C","page":26,"section":"vocabulary"},{"book":"advp","unit":1,"lesson":"1A","section":"vocabulary_bank"}]],["somebody","/ˈsʌmbədi/","PRON","biri","кто-то","a person you do not name","Somebody called for you.","Biri seni sorady.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":3,"lesson":"3C","page":26,"section":"vocabulary"}]],["somewhere","/ˈsʌmweə(r)/","ADV","bir ýerde","где-то","a place you do not name","I put it somewhere in this room.","Ony şu otagyň bir ýerine goýdum.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":3,"lesson":"3C","page":26,"section":"vocabulary"}]],["kind of","/kaɪnd əv/","PHR","bir görnüş","вроде, типа","a type of something","It is a kind of bread.","Ol bir görnüş çörek.","A2","Oxford 3000","—","a kind of","New",[{"book":"pre","unit":3,"lesson":"3C","page":26,"section":"vocabulary"},{"book":"advp","unit":1,"lesson":"1A","section":"vocabulary_bank"}]],["sort of","/sɔːt əv/","PHR","bir görnüşli","что-то вроде","a type of something","We watched a sort of comedy.","Bir görnüş komediýa seretdik.","A2","Oxford 3000","—","a sort of","New",[{"book":"pre","unit":3,"lesson":"3C","page":26,"section":"vocabulary"},{"book":"advp","unit":1,"lesson":"1A","section":"vocabulary_bank"}]],["actually","/ˈæktʃuəli/","ADV","aslynda","на самом деле","in fact; really","Actually, I have never been there.","Aslynda, ol ýerde hiç wagt bolmadym.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":3,"lesson":"3C","page":26,"section":"vocabulary"}]],["basically","/ˈbeɪsɪkli/","ADV","esasan","в основном","in the most important way","Basically, we just need more time.","Esasan, bize diňe köpräk wagt gerek.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":3,"lesson":"3C","page":26,"section":"vocabulary"}]],["etc.","/et ˈsetərə/","ADV","we ş.m.","и т.д.","and other similar things","Buy fruit: apples, pears, etc.","Miwe al: alma, armut we ş.m.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":3,"lesson":"3C","page":26,"section":"vocabulary"}]],["do the ironing","/duː ði ˈaɪənɪŋ/","PHR","eşik ütükleme işi","глажка белья","to make clothes flat with an iron","He does the ironing on Sundays.","Ol ýekşenbe güni eşikleri ütikleýär.","A2","Oxford 3000","—","do the ironing","New",[{"book":"pre","unit":4,"lesson":"4A","page":30,"section":"vocabulary_bank"}]],["do the washing-up","/duː ðə ˈwɒʃɪŋ ʌp/","PHR","gap-gaç ýuwmak","мыть посуду","to wash plates and cups after a meal","I cooked, so you do the washing-up.","Men bişirdim, gap-gaçy sen ýuw.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4A","page":30,"section":"vocabulary_bank"}]],["make the bed","/meɪk ðə bed/","PHR","düşek ýygnamak","заправлять кровать","to arrange the sheets and blankets neatly","She makes her bed every morning.","Ol her ertir düşegini ýygnaýar.","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4A","page":30,"section":"vocabulary_bank"}]],["tidy","/ˈtaɪdi/","V","ýygnamak","убирать","to make a place neat","Tidy your room before you go out.","Çykmazdan otagyňy ýygna.","A2","Oxford 3000","—","tidy your room","New",[{"book":"pre","unit":4,"lesson":"4A","page":30,"section":"vocabulary_bank"}]],["sweep","/swiːp/","V","süpürmek","мести","to clean the floor with a brush","I swept the kitchen floor.","Aşhana poluny süpürdim.","A2","Oxford 3000","—","sweep the floor","New",[{"book":"pre","unit":4,"lesson":"4A","page":30,"section":"vocabulary_bank"}]],["dust","/dʌst/","V","tozan almak","вытирать пыль","to remove dust from furniture","She dusted the shelves.","Tekjeleriň tozanyny aldy.","A2","Oxford 3000","—","dust the furniture","New",[{"book":"pre","unit":4,"lesson":"4A","page":30,"section":"vocabulary_bank"}]],["vacuum","/ˈvækjuːm/","V","sorujy bilen arassalamak","пылесосить","to clean with a vacuum cleaner","He vacuums the carpet every week.","Her hepde haly sorýar.","A2","Oxford 3000","—","vacuum the carpet","New",[{"book":"pre","unit":4,"lesson":"4A","page":30,"section":"vocabulary_bank"}]],["fold","/fəʊld/","V","eplemek","складывать","to bend clothes neatly into shape","I folded the clean shirts.","Arassa köýnekleri epledim.","B1","Oxford 5000","—","fold the clothes","New",[{"book":"pre","unit":4,"lesson":"4A","page":30,"section":"vocabulary_bank"},{"book":"intp","unit":2,"lesson":"2A","page":16,"section":"vocabulary_bank"}]],["set the table","/set ðə ˈteɪbl/","PHR","süfra ýazmak","накрывать на стол","to put plates and cutlery ready for a meal","Please set the table for four.","Dört adamlyk süfra ýaz.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4A","page":30,"section":"vocabulary_bank"}]],["take out the rubbish","/teɪk aʊt ðə ˈrʌbɪʃ/","PHR","zibil dökmek","выносить мусор","to carry the rubbish outside","It is your turn to take out the rubbish.","Zibili dökmek nobaty sende.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4A","page":30,"section":"vocabulary_bank"}]],["bargain","/ˈbɑːɡən/","N","arzan satyn alyş","выгодная покупка","something bought at a very good price","These shoes were a real bargain.","Bu aýakgap hakykatdan arzan düşdi.","A2","Oxford 3000","—","a real bargain","New",[{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"}]],["cash","/kæʃ/","N","nagt pul","наличные","money in coins and notes","I paid in cash.","Nagt pul bilen töledim.","A2","Oxford 3000","—","pay in cash","New",[{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"}]],["changing room","/ˈtʃeɪndʒɪŋ ruːm/","N","synag otagy","примерочная","a room where you try on clothes in a shop","The changing rooms are over there.","Synag otaglary şol ýerde.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"}]],["customer","/ˈkʌstəmə(r)/","N","müşderi","покупатель","a person who buys from a shop","The customer asked for a smaller size.","Müşderi kiçi ölçeg sorady.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"}]],["discount","/ˈdɪskaʊnt/","N","arzanladyş","скидка","a reduction in the usual price","Students get a ten per cent discount.","Talyplar on göterim arzanladyş alýar.","A2","Oxford 3000","—","get a discount","New",[{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"}]],["receipt","/rɪˈsiːt/","N","çek","чек","a piece of paper showing what you paid","Keep the receipt in case you return it.","Yzyna gaýtarsaň çek sakla.","A2","Oxford 3000","—","keep the receipt","New",[{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"}]],["refund","/ˈriːfʌnd/","N","pul yzyna gaýtarma","возврат денег","money given back when you return something","I got a full refund.","Doly pulumy yzyna aldym.","B1","Oxford 5000","—","get a refund","New",[{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"}]],["reduce","/rɪˈdjuːs/","V","arzanlatmak","снижать","to make the price lower","They reduced all winter coats.","Ähli gyş paltolaryny arzanlatdylar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"}]],["value for money","/ˈvælju fə ˈmʌni/","PHR","pula degýän","соотношение цены и качества","worth the price you pay","The hotel is good value for money.","Myhmanhana puluna degýär.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"}]],["basket","/ˈbɑːskɪt/","N","sebet","корзина","a container you carry when shopping","Put the bread in the basket.","Çöregi sebede sal.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"}]],["checkout","/ˈtʃekaʊt/","N","kassa","касса (место оплаты)","the place where you pay in a shop","Pay at the checkout, please.","Kassada töläň, haýyş.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"}]],["delivery","/dɪˈlɪvəri/","N","eltip bermek","доставка","when goods are brought to your house","The delivery took two days.","Eltip bermek iki gün aldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"},{"book":"int","unit":8,"lesson":"8B","page":80,"section":"vocabulary"}]],["item","/ˈaɪtəm/","N","haryt","товар, предмет","a single thing in a list or a shop","This item was in the sale.","Bu haryt arzanladyşda boldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"}]],["shelves","/ˈʃelvz/","N","tekçeler","полки","flat boards where things are kept in a shop","The books are on the top shelves.","Kitaplar ýokarky tekçelerde.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"}]],["till","/tɪl/","N","kassa","касса (аппарат)","the machine where you pay in a shop","She put the money in the till.","Puly kassa saldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"}]],["trolley","/ˈtrɒli/","N","söwda arabasy","тележка","a large basket on wheels you push in a supermarket","Put the milk in the trolley.","Süýdi araba sal.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"}]],["auction","/ˈɔːkʃn/","N","auksion","аукцион","a sale where people offer more and more money for a thing","The painting was sold at auction.","Surat auksionda satyldy.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":4,"lesson":"4B","page":32,"section":"vocabulary_bank"}]],["boring","/ˈbɔːrɪŋ/","ADJ","gysgynç","скучный","not interesting","The film was really boring.","Film hakykatdan gysgynç boldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["excited","/ɪkˈsaɪtɪd/","ADJ","tolgunan","взволнованный","feeling happy about something coming","She was excited about the trip.","Syýahat barada tolgundy.","A2","Oxford 3000","—","excited about","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["exciting","/ɪkˈsaɪtɪŋ/","ADJ","tolgunçylykly","увлекательный","making you feel excited","It was an exciting match.","Tolgunçylykly oýun boldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["interested","/ˈɪntrəstɪd/","ADJ","gyzyklanýan","заинтересованный","wanting to know more about something","He is interested in history.","Taryha gyzyklanýar.","A1","Oxford 3000","—","interested in","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["interesting","/ˈɪntrəstɪŋ/","ADJ","gyzykly","интересный","making you want to know more","She told us an interesting story.","Gyzykly hekaýa gürrüň berdi.","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["surprising","/səˈpraɪzɪŋ/","ADJ","geň","удивительный","making you feel surprise","The news was surprising.","Habar geň boldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["tiring","/ˈtaɪərɪŋ/","ADJ","ýadadýan","утомительный","making you feel tired","It was a long tiring day.","Uzyn ýadadýan gün boldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["amazed","/əˈmeɪzd/","ADJ","haýran galan","изумлённый","feeling great surprise","We were amazed by the view.","Görnüşe haýran galdyk.","A2","Oxford 3000","—","amazed by","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["amazing","/əˈmeɪzɪŋ/","ADJ","haýran galdyryjy","изумительный","very good; causing surprise","The food was amazing.","Nahar ajaýyp bolady.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["confused","/kənˈfjuːzd/","ADJ","bulaşan","запутавшийся","unable to understand clearly","I got confused by the instructions.","Görkezmelerden bulaşdym.","A2","Oxford 3000","—","confused by","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["confusing","/kənˈfjuːzɪŋ/","ADJ","bulaşdyryjy","запутанный","difficult to understand","The rules are confusing.","Düzgünler bulaşdyryjy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["disappointed","/ˌdɪsəˈpɔɪntɪd/","ADJ","lapykeç","разочарованный","unhappy because something was not as good as you hoped","She was disappointed with the result.","Netijeden lapykeç boldy.","A2","Oxford 3000","—","disappointed with","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["disappointing","/ˌdɪsəˈpɔɪntɪŋ/","ADJ","lapykeç ediji","разочаровывающий","not as good as you hoped","The concert was disappointing.","Konsert lapykeç ediji boldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["embarrassed","/ɪmˈbærəst/","ADJ","utançly","смущённый","feeling shy or ashamed","He felt embarrassed about his mistake.","Ýalňyşy üçin utançly boldy.","A2","Oxford 3000","—","embarrassed about","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"},{"book":"upp","unit":5,"lesson":"5A","section":"vocabulary_bank"}]],["embarrassing","/ɪmˈbærəsɪŋ/","ADJ","utançly ýagdaý","неловкий","making you feel embarrassed","It was an embarrassing moment.","Utançly pursat boldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["shocked","/ʃɒkt/","ADJ","şok bolan","потрясённый","feeling sudden strong surprise","We were shocked by the news.","Habar bizi şok etdi.","A2","Oxford 3000","—","shocked by","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["shocking","/ˈʃɒkɪŋ/","ADJ","şok ediji","потрясающий (негативно)","very bad and surprising","The weather was shocking.","Howa şok ediji boldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["frightening","/ˈfraɪtnɪŋ/","ADJ","gorkuzýan","пугающий","making you feel fear","It was a frightening experience.","Gorkuzýan tejribe boldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":4,"lesson":"4C","page":34,"section":"vocabulary"}]],["twice","/twaɪs/","ADV","iki gezek","дважды","two times","I have been there twice.","Ol ýerde iki gezek boldum.","A2","Oxford 3000","—","twice a week","New",[{"book":"pre","unit":5,"lesson":"5A","page":38,"section":"vocabulary"}]],["dozen","/ˈdʌzn/","N","on ikilik","дюжина","the number twelve; a set of twelve","She bought two dozen eggs.","Iki on iki ýumurtga aldy.","B1","Oxford 5000","—","a dozen eggs","New",[{"book":"pre","unit":5,"lesson":"5A","page":38,"section":"vocabulary"},{"book":"advp","unit":6,"lesson":"6B","section":"vocabulary_bank"}]],["a couple of","/ə ˈkʌpl əv/","PHR","birnäçe","пара, несколько","two or a few","I need a couple of minutes.","Birnäçe minut gerek.","A2","Oxford 3000","—","a couple of days","New",[{"book":"pre","unit":5,"lesson":"5A","page":38,"section":"vocabulary"}]],["approximately","/əˈprɒksɪmətli/","ADV","takmynan","приблизительно","about; not exactly","The trip costs approximately 500 manat.","Syýahat takmynan 500 manat durýar.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":5,"lesson":"5A","page":38,"section":"vocabulary"},{"book":"advp","unit":1,"lesson":"1A","section":"vocabulary_bank"}]],["exactly","/ɪɡˈzæktli/","ADV","takyk","точно","in a precise way; completely","The train leaves at exactly six.","Otly takyk altyda gidýär.","A2","Oxford 3000","—","exactly right","New",[{"book":"pre","unit":5,"lesson":"5A","page":38,"section":"vocabulary"}]],["per cent","/pə ˈsent/","N","göterim","процент","one part in every hundred","Sixty per cent said yes.","Altmış göterim hawa diýdi.","A2","Oxford 3000","—","fifty per cent","New",[{"book":"pre","unit":5,"lesson":"5A","page":38,"section":"vocabulary"},{"book":"advp","unit":6,"lesson":"6B","section":"vocabulary_bank"}]],["increase","/ɪnˈkriːs/","V","köpeltmek","увеличивать(ся)","to become or make bigger","Sales increased by ten per cent.","Satuwlar on göterim artdy.","A2","Oxford 3000","—","increase by","New",[{"book":"pre","unit":5,"lesson":"5A","page":38,"section":"vocabulary"}]],["decrease","/dɪˈkriːs/","V","azaltmak","уменьшать(ся)","to become or make smaller","The temperature decreased at night.","Gije temperatura azaldy.","A2","Oxford 3000","—","decrease by","New",[{"book":"pre","unit":5,"lesson":"5A","page":38,"section":"vocabulary"}]],["ancient","/ˈeɪnʃənt/","ADJ","gadymy","древний","very old; from long ago","We visited the ancient city walls.","Gadymy şäher diwarlaryna baryp gördük.","A2","Oxford 3000","—","ancient ruins","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"},{"book":"intp","unit":8,"lesson":"8B","page":80,"section":"vocabulary"}]],["atmosphere","/ˈætməsfɪə(r)/","N","howa (duýgy)","атмосфера","the feeling a place gives you","The old town has a lovely atmosphere.","Köne şäheriň ajaýyp howasy bar.","B1","Oxford 5000","—","a relaxed atmosphere","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"}]],["capital","/ˈkæpɪtl/","N","paýtagt","столица","the most important city of a country","Ashgabat is the capital of Turkmenistan.","Aşgabat Türkmenistanyň paýtagty.","A2","Oxford 3000","—","the capital city","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"}]],["city centre","/ˈsɪti ˈsentə(r)/","N","şäher merkezi","центр города","the middle of a city where the shops are","We walked to the city centre.","Şäher merkezine pyýada gitdik.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"}]],["crowded","/ˈkraʊdɪd/","ADJ","märeli","переполненный","full of people","The market was hot and crowded.","Bazar yssy we märeli boldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"}]],["dull","/dʌl/","ADJ","gysgynç","скучный","not interesting; boring","Life in the village seemed dull to him.","Obadaky durmuş oňa gysgynç görünýärdi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"},{"book":"intp","unit":1,"lesson":"1B","page":10,"section":"vocabulary_bank"}]],["historic","/hɪˈstɒrɪk/","ADJ","taryhy","исторический","important in history","Merv is a historic city.","Merw taryhy şäher.","A2","Oxford 3000","—","a historic building","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"},{"book":"adv","unit":10,"lesson":"10B","section":"vocabulary"}]],["modern","/ˈmɒdn/","ADJ","häzirki zaman","современный","of the present time; new ideas and style","The modern part of the city has tall towers.","Şäheriň häzirki zaman böleginde beýik diňler bar.","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"}]],["multicultural","/ˌmʌltiˈkʌltʃərəl/","ADJ","köpmedeniýetli","многокультурный","with many different cultures living together","London is a truly multicultural city.","London hakykatdan köpmedeniýetli şäher.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"}]],["polluted","/pəˈluːtɪd/","ADJ","hapalanan","загрязнённый","made dirty by chemicals or waste","The air in the city is polluted.","Şäherdäki howa hapalanan.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"}]],["residential","/ˌrezɪˈdenʃl/","ADJ","ýaşaýyş","жилой","where people live; not offices or shops","They live in a quiet residential area.","Olar asuda ýaşaýyş sebitinde ýaşaýarlar.","B1","Oxford 5000","—","a residential area","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"}]],["traffic","/ˈtræfɪk/","N","ulag hereketi","движение транспорта","vehicles moving on a road","The traffic is terrible in the morning.","Irden ulag hereketi elhenç.","A2","Oxford 3000","—","heavy traffic","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"}]],["lively","/ˈlaɪvli/","ADJ","joşgunly","оживлённый, энергичный","full of life and energy","The market square is lively on Saturdays.","Bazar meýdançasy şenbe günleri joşgunly.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"}]],["tourist","/ˈtʊərɪst/","N","syýahatçy","турист","a person visiting a place for pleasure","The city is full of tourists in summer.","Tomusda şäher syýahatçylardan doly.","A2","Oxford 3000","—","a tourist attraction","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"},{"book":"adv","unit":8,"lesson":"8B","section":"vocabulary_bank"}]],["canal","/kəˈnæl/","N","kanal","канал","a river made by people for boats","We walked along the canal.","Kanalyň boýy ýöräp gitdik.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"}]],["harbour","/ˈhɑːbə/","N","port","гавань, порт","a place where ships are safe","The boats are in the harbour.","Gämiler portda.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"}]],["hill","/hɪl/","N","depe","холм","like a small mountain","We climbed to the top of the hill.","Depäniň depesine çykdym.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"},{"book":"intp","unit":5,"lesson":"5B","page":50,"section":"vocabulary_bank"}]],["lake","/leɪk/","N","köl","озеро","a large area of water","We swam in the lake.","Kölde ýüzdük.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"},{"book":"intp","unit":5,"lesson":"5B","page":50,"section":"vocabulary_bank"}]],["ruins","/ˈruːɪnz/","N","harabalyk","руины","parts of very old broken buildings","We visited some Roman ruins.","Rim harabalyklaryny gördük.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"},{"book":"intp","unit":8,"lesson":"8B","page":80,"section":"vocabulary"}]],["statue","/ˈstætʃuː/","N","heýkel","статуя","a figure of a person or animal made of stone or metal","There is a statue in the square.","Meýdançada heýkel bar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"},{"book":"intp","unit":8,"lesson":"8B","page":80,"section":"vocabulary"}]],["city walls","/ˌsɪti ˈwɔːlz/","N","şäher diwarlary","городские стены","old walls built around a city","You can walk on the city walls.","Şäher diwarlarynda ýöräp bolýar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"}]],["area","/ˈeəriə/","N","sebit","район, область","a part of a town or country","It is a quiet area of the city.","Şäheriň asuda sebiti.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"},{"book":"advp","unit":6,"lesson":"6B","section":"vocabulary_bank"}]],["coast","/kəʊst/","N","kenar","побережье","the land next to the sea","They live on the south coast.","Olar günorta kenarda ýaşaýar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"}]],["medium-sized","/ˌmiːdiəm ˈsaɪzd/","ADJ","orta ululykda","среднего размера","not big and not small","It is a medium-sized town.","Ol orta ululykda şäher.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5B","page":40,"section":"vocabulary_bank"}]],["headache","/ˈhedeɪk/","N","baş agyry","головная боль","pain in the head","I have a terrible headache.","Elhenç baş agyrym bar.","A2","Oxford 3000","—","have a headache","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"},{"book":"upp","unit":2,"lesson":"2A","section":"vocabulary_bank"}]],["stomach ache","/ˈstʌmək eɪk/","N","garyn agyry","боль в животе","pain in the stomach","He has a stomach ache.","Onuň garyn agyrysy bar.","A2","Oxford 3000","—","have a stomach ache","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"}]],["sore throat","/sɔː θrəʊt/","N","bogaz agyry","больное горло","pain in the throat","I have a sore throat and a cough.","Bogaz agyrym we üsgülewügim bar.","A2","Oxford 3000","—","have a sore throat","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"}]],["cough","/kɒf/","N","üsgülewük","кашель","the act of forcing air out noisily","Her cough got worse at night.","Üsgülewügi gije ýaramazlaşdy.","A2","Oxford 3000","—","have a cough","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"}]],["flu","/fluː/","N","dümew","грипп","an illness like a bad cold","She stayed home with the flu.","Dümew bilen öýde galdy.","A2","Oxford 3000","—","have the flu","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"}]],["pain","/peɪn/","N","agyry","боль","the feeling of hurting","He felt a sharp pain in his leg.","Aýagynda ýiti agyry duýdy.","A2","Oxford 3000","—","feel pain","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"}]],["pill","/pɪl/","N","derman kökesi","таблетка","a small round piece of medicine","Take two pills after food.","Nahardan soň iki köke iç.","A2","Oxford 3000","—","take a pill","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"}]],["patient","/ˈpeɪʃnt/","N","näsag","пациент","a person being treated by a doctor","The doctor saw twenty patients today.","Lukman şu gün ýigrimi näsaga seretdi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"},{"book":"int","unit":1,"lesson":"1B","page":10,"section":"vocabulary"},{"book":"adv","unit":1,"lesson":"1A","section":"vocabulary_bank"}]],["dizzy","/ˈdɪzi/","ADJ","başy aýlanan","испытывающий головокружение","feeling that everything is moving","I felt dizzy after the ride.","Atlanyşykdan soň başym aýlandy.","B1","Oxford 5000","—","feel dizzy","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"},{"book":"upp","unit":2,"lesson":"2A","section":"vocabulary_bank"}]],["hurt","/hɜːt/","V","agyrtmak","болеть, причинять боль","to feel or cause pain","My back hurts when I sit.","Otyran wagtym arkam agyrýar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"}]],["injured","/ˈɪndʒəd/","ADJ","şikes alan","травмированный","hurt in an accident","Two players were injured.","Iki oýunçy şikes aldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"}]],["recover","/rɪˈkʌvə(r)/","V","sagalmak","выздоравливать","to become well again","She recovered quickly.","Ol çalt sagaldy.","B1","Oxford 5000","—","recover from","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"},{"book":"upp","unit":2,"lesson":"2A","section":"vocabulary_bank"}]],["blood","/blʌd/","N","gan","кровь","the red liquid in your body","The doctor took some blood.","Lukman biraz gan aldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"}]],["bones","/bəʊnz/","N","süňkler","кости","the hard parts inside your body","Exercise is good for your bones.","Maşk süňkler üçin peýdaly.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"}]],["heart","/hɑːt/","N","ýürek","сердце","the part of your body that moves blood","Running is good for your heart.","Ylgaw ýürek üçin peýdaly.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"}]],["liver","/ˈlɪvə/","N","bagyr","печень","the part of your body that cleans your blood","Alcohol is bad for your liver.","Alkogol bagyr üçin zyýanly.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"},{"book":"upp","unit":7,"lesson":"7B","section":"vocabulary_bank"}]],["muscles","/ˈmʌslz/","N","myşsalar","мышцы","the parts of your body that make you move","Swimming builds your muscles.","Ýüzmek myşsalary berkidýär.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"}]],["teeth","/tiːθ/","N","dişler","зубы","the hard white parts in your mouth","Clean your teeth twice a day.","Günde iki gezek dişleriňi arassala.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"},{"book":"int","unit":6,"lesson":"6B","page":60,"section":"vocabulary_bank"}]],["alcohol","/ˈælkəhɒl/","N","alkogol","алкоголь","drinks like beer and wine","He never drinks alcohol.","Ol hiç wagt alkogol içmeýär.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"}]],["worry","/ˈwʌri/","V","alada etmek","беспокоиться","to feel unhappy about problems","Don't worry about the exam.","Synag barada alada etme.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"}]],["borrow","/ˈbɒrəʊ/","V","karzyna almak","брать взаймы","to take something and give it back later","Can I borrow your pen?","Galamyňy karzyna alyp bolarmy?","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6A","page":46,"section":"vocabulary_bank"},{"book":"int","unit":2,"lesson":"2A","page":16,"section":"vocabulary_bank"},{"book":"upp","unit":7,"lesson":"7A","section":"vocabulary_bank"}]],["lend","/lend/","V","karzyna bermek","давать взаймы","to let someone use your things for a time","She lent me her umbrella.","Ol maňa ýaglygyny karzyna berdi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6A","page":46,"section":"vocabulary_bank"},{"book":"int","unit":2,"lesson":"2A","page":16,"section":"vocabulary_bank"},{"book":"upp","unit":7,"lesson":"7A","section":"vocabulary_bank"}]],["remember","/rɪˈmembə(r)/","V","ýatda saklamak","помнить","to have an image of something in your mind","I remember my first day at school.","Mekdepdäki ilkinji günimi ýatda saklaýaryn.","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6A","page":46,"section":"vocabulary_bank"},{"book":"pre","unit":9},{"book":"upp","unit":7,"lesson":"7A","section":"vocabulary_bank"}]],["lose","/luːz/","V","ýitirmek","терять","to not have something any more","He lost his wallet on the bus.","Awtobusda gapjygyny ýitirdi.","A1","Oxford 3000","—","lose your keys","New",[{"book":"pre","unit":6,"lesson":"6A","page":46,"section":"vocabulary_bank"}]],["win","/wɪn/","V","utuşmak","выигрывать","to be the best in a game or competition","Our team won the match.","Toparymyz oýunda utdy.","A2","Oxford 3000","—","win a prize","New",[{"book":"pre","unit":6,"lesson":"6A","page":46,"section":"vocabulary_bank"}]],["fail","/feɪl/","V","synagdan ýykylyp galmak","проваливать(ся)","to not pass a test","She failed her driving test twice.","Sürüjilik synagyndan iki gezek ýykyldy.","A2","Oxford 3000","—","fail an exam","New",[{"book":"pre","unit":6,"lesson":"6A","page":46,"section":"vocabulary_bank"},{"book":"intp","unit":10,"lesson":"10B","page":100,"section":"vocabulary"}]],["pass","/pɑːs/","V","synagdan geçmek","сдавать (экзамен)","to succeed in a test","He passed all his exams.","Ähli synaglardan geçdi.","A2","Oxford 3000","—","pass an exam","New",[{"book":"pre","unit":6,"lesson":"6A","page":46,"section":"vocabulary_bank"},{"book":"intp","unit":10,"lesson":"10B","page":100,"section":"vocabulary"}]],["raise","/reɪz/","V","galdyrmak","поднимать","to move something to a higher position","She raised her hand to ask a question.","Sorag bermek üçin elini galdyrdy.","A2","Oxford 3000","—","raise your hand","New",[{"book":"pre","unit":6,"lesson":"6A","page":46,"section":"vocabulary_bank"},{"book":"int","unit":2,"lesson":"2A","page":16,"section":"vocabulary_bank"},{"book":"upp","unit":7,"lesson":"7A","section":"vocabulary_bank"}]],["lower","/ˈləʊə(r)/","V","aşak düşürmek","опускать","to move something down","He lowered his voice.","Ol sesini aşak düşürdi.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":6,"lesson":"6A","page":46,"section":"vocabulary_bank"}]],["close","/kləʊz/","V","ýapmak","закрывать","to make something not open","Please close the window.","Öýjügi ýapmagyňyzy haýyş edýärin.","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6A","page":46,"section":"vocabulary_bank"}]],["mend","/mend/","V","ýamamak, bejermek","чинить, штопать","to repair something, especially clothes","She mended the hole in my shirt.","Köýnegimdäki deşigi ýamady.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6A","page":46,"section":"vocabulary_bank"},{"book":"intp","unit":6,"lesson":"6B","page":60,"section":"vocabulary_bank"}]],["repair","/rɪˈpeə/","V","bejermek","ремонтировать","to make something work again","He repaired the bike.","Welosipedi bejerdi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6A","page":46,"section":"vocabulary_bank"}]],["pull","/pʊl/","V","dartmak, çekmek","тянуть","to move something towards you","Pull the door to open it.","Gapyny açmak üçin dart.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6A","page":46,"section":"vocabulary_bank"}]],["push","/pʊʃ/","V","itmek","толкать","to move something away from you","Push the door to close it.","Gapyny ýapmak üçin it.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6A","page":46,"section":"vocabulary_bank"}]],["receive","/rɪˈsiːv/","V","almak","получать","to get something that is sent to you","I received your email.","Emailiňi aldym.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6A","page":46,"section":"vocabulary_bank"}]],["open","/ˈəʊpən/","V","açmak","открывать","to make something not closed","They open the shop at nine.","Dükany sagat dokuzda açýarlar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6A","page":46,"section":"vocabulary_bank"}]],["call back","/kɔːl bæk/","PHR","yzyna jaň etmek","перезванивать","to phone someone again","I'll call you back later.","Soňra yzyna jaň ederin.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6B","page":48,"section":"vocabulary"},{"book":"intp","unit":7,"lesson":"7A","page":66,"section":"vocabulary_bank"}]],["come back","/kʌm bæk/","PHR","yzyna gelmek","возвращаться","to return to a place","When will you come back?","Haçan yzyňa gelýärsiň?","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6B","page":48,"section":"vocabulary"}]],["get back","/ɡet bæk/","PHR","yzyna ýetmek","возвращаться (прибывать)","to arrive back","We got back at midnight.","Gije ýarymda yzymyza ýetdik.","A2","Oxford 3000","—","get back home","New",[{"book":"pre","unit":6,"lesson":"6B","page":48,"section":"vocabulary"},{"book":"intp","unit":7,"lesson":"7A","page":66,"section":"vocabulary_bank"}]],["give back","/ɡɪv bæk/","PHR","yzyna bermek","возвращать","to return something you borrowed","Give back my book, please.","Kitabymy yzyna ber.","A2","Oxford 3000","—","give back the money","New",[{"book":"pre","unit":6,"lesson":"6B","page":48,"section":"vocabulary"},{"book":"intp","unit":7,"lesson":"7A","page":66,"section":"vocabulary_bank"}]],["go back","/ɡəʊ bæk/","PHR","yzyna gitmek","возвращаться (уходить)","to return to a place","I want to go back to Spain.","Ispaniýa yzyna gitmek isleýärin.","A1","Oxford 3000","—","go back home","New",[{"book":"pre","unit":6,"lesson":"6B","page":48,"section":"vocabulary"}]],["pay back","/peɪ bæk/","PHR","karzyňy gaýtarmak","возвращать (деньги)","to return money you borrowed","I will pay you back tomorrow.","Ertin puluňy yzyna bererin.","A2","Oxford 3000","—","pay back a loan","New",[{"book":"pre","unit":6,"lesson":"6B","page":48,"section":"vocabulary"},{"book":"int","unit":2,"lesson":"2A","page":16,"section":"vocabulary_bank"},{"book":"intp","unit":7,"lesson":"7A","page":66,"section":"vocabulary_bank"}]],["put back","/pʊt bæk/","PHR","yzyna goýmak","класть обратно","to put something where it was","Put the milk back in the fridge.","Süýdi sowadyja yzyna goý.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6B","page":48,"section":"vocabulary"}]],["take back","/teɪk bæk/","PHR","yzyna gaýtarmak","возвращать (в магазин)","to return something to a shop","I took the jacket back.","Kurtkany yzyna gaýtardym.","A2","Oxford 3000","—","take back to the shop","New",[{"book":"pre","unit":6,"lesson":"6B","page":48,"section":"vocabulary"}]],["talk back","/tɔːk bæk/","PHR","jogap gaýtarmak","огрызаться","to answer someone rudely","Never talk back to your teacher.","Mugallyma hiç wagt jogap gaýtarma.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":6,"lesson":"6B","page":48,"section":"vocabulary"}]],["write back","/raɪt bæk/","PHR","yzyna ýazmak","отвечать (письмом)","to reply to a message","She wrote back the same day.","Şol gün yzyna ýazdy.","A2","Oxford 3000","—","write back soon","New",[{"book":"pre","unit":6,"lesson":"6B","page":48,"section":"vocabulary"}]],["rather","/ˈrɑːðə(r)/","ADV","biraz (güýçli)","довольно (сильно)","quite; more than expected","It was rather cold yesterday.","Düýn howa biraz sowuk bolady.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6C","page":50,"section":"vocabulary"}]],["pretty","/ˈprɪti/","ADV","gaty (gürlüşde)","довольно (разг.)","quite; fairly (informal)","The test was pretty easy.","Synag gaty aňsat bolady.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6C","page":50,"section":"vocabulary"}]],["fairly","/ˈfeəli/","ADV","birneme","весьма","quite; but not very","The hotel was fairly cheap.","Myhmanhana birneme arzan boldy.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":6,"lesson":"6C","page":50,"section":"vocabulary"}]],["a bit","/ə bɪt/","PHR","birjyk","немного","a small amount","The soup is a bit cold.","Çorba birjyk sowuk.","A2","Oxford 3000","—","a bit tired","New",[{"book":"pre","unit":6,"lesson":"6C","page":50,"section":"vocabulary"}]],["slightly","/ˈslaɪtli/","ADV","birjyk (az)","слегка","a little; not much","The price is slightly higher now.","Baha indi birjyk ýokary.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":6,"lesson":"6C","page":50,"section":"vocabulary"},{"book":"upp","unit":3,"lesson":"3B","section":"vocabulary_bank"}]],["particularly","/pəˈtɪkjələli/","ADV","aýratyn","особенно","especially; more than usual","I wasn't particularly hungry.","Aýratyn aç däldim.","B1","Oxford 5000","—","not particularly","New",[{"book":"pre","unit":6,"lesson":"6C","page":50,"section":"vocabulary"},{"book":"upp","unit":3,"lesson":"3B","section":"vocabulary_bank"}]],["absolutely","/ˈæbsəluːtli/","ADV","düýbünden","абсолютно","completely","You are absolutely right.","Düýbünden dogry aýdýarsyň.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6C","page":50,"section":"vocabulary"},{"book":"upp","unit":3,"lesson":"3B","section":"vocabulary_bank"}]],["completely","/kəmˈpliːtli/","ADV","doly","полностью","in every way; totally","I completely forgot your birthday.","Doglan günüňi doly ýatdan çykarypdym.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6C","page":50,"section":"vocabulary"}]],["totally","/ˈtəʊtəli/","ADV","düýbünden doly","совершенно","completely","The two brothers are totally different.","Iki dogan düýbünden başga.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":6,"lesson":"6C","page":50,"section":"vocabulary"},{"book":"upp","unit":3,"lesson":"3B","section":"vocabulary_bank"}]],["manage","/ˈmænɪdʒ/","V","hötdesinden gelmek","справляться","to succeed in doing something difficult","He managed to fix the bike.","Welosipedi bejermegiň hötdesinden geldi.","A2","Oxford 3000","—","manage to do","New",[{"book":"pre","unit":7,"lesson":"7A","page":54,"section":"vocabulary_bank"}]],["offer to","/ˈɒfə(r) tuː/","PHR","etmegi teklip etmek","предлагать сделать","to say you will do something","She offered to help me.","Maňa kömek etmegi teklip etdi.","A2","Oxford 3000","—","offer to help","New",[{"book":"pre","unit":7,"lesson":"7A","page":54,"section":"vocabulary_bank"}]],["expect","/ɪkˈspekt/","V","garamak","ожидать","to think something will happen (expect to do)","We expect to arrive at six.","Altida ýeteris diýip garaýarys.","A2","Oxford 3000","—","expect to win","New",[{"book":"pre","unit":7,"lesson":"7A","page":54,"section":"vocabulary_bank"}]],["afford","/əˈfɔːd/","V","güýji ýetmek","позволить себе","to have enough money for something","I can't afford a new phone.","Täze telefona güýjüm ýetmeýär.","A2","Oxford 3000","—","can't afford","New",[{"book":"pre","unit":7,"lesson":"7A","page":54,"section":"vocabulary_bank"}]],["arrange","/əˈreɪndʒ/","V","gurnamak","договариваться","to plan something (arrange to do)","We arranged to meet at noon.","Günortan duşuşmaga gurnadyk.","B1","Oxford 5000","—","arrange to meet","New",[{"book":"pre","unit":7,"lesson":"7A","page":54,"section":"vocabulary_bank"}]],["avoid","/əˈvɔɪd/","V","gaça durmak","избегать","to keep away from something (avoid doing)","He avoids driving in the centre.","Merkezde ulag sürmekden gaça durýar.","A2","Oxford 3000","—","avoid talking","New",[{"book":"pre","unit":7,"lesson":"7B","page":56,"section":"vocabulary_bank"}]],["finish","/ˈfɪnɪʃ/","V","gutarmak","заканчивать","to complete something (finish doing)","Have you finished eating?","Iýip gutardyňmy?","A1","Oxford 3000","—","finish working","New",[{"book":"pre","unit":7,"lesson":"7B","page":56,"section":"vocabulary_bank"}]],["keep","/kiːp/","V","dowam etmek","продолжать","to continue doing something","She keeps forgetting my name.","Adymy yzygiderli ýatdan çykarýar.","A2","Oxford 3000","—","keep trying","New",[{"book":"pre","unit":7,"lesson":"7B","page":56,"section":"vocabulary_bank"}]],["mind","/maɪnd/","V","garşy bolmak","возражать","to be annoyed by something (mind doing)","I don't mind waiting.","Garaşmaga garşy däl.","A2","Oxford 3000","—","don't mind doing","New",[{"book":"pre","unit":7,"lesson":"7B","page":56,"section":"vocabulary_bank"}]],["miss","/mɪs/","V","küýsemek","скучать","to feel sad that something is gone (miss doing)","I miss living near the sea.","Deňziň ýanynda ýaşamagy küýseýärin.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":7,"lesson":"7B","page":56,"section":"vocabulary_bank"}]],["suggest","/səˈdʒest/","V","teklip etmek","предлагать (идею)","to put forward an idea (suggest doing)","She suggested going by train.","Otly bilen gitmegi teklip etdi.","A2","Oxford 3000","—","suggest going","New",[{"book":"pre","unit":7,"lesson":"7B","page":56,"section":"vocabulary_bank"}]],["would rather","/wʊd ˈrɑːðə(r)/","PHR","gowy görerdim","лучше бы","to prefer one thing to another","I'd rather stay at home.","Öýde galmagy gowy görerdim.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":7,"lesson":"7B","page":56,"section":"vocabulary_bank"}]],["used to","/ˈjuːst tuː/","PHR","öň ederdi","раньше делал","something true in the past but not now","We used to live in a village.","Öň obada ýaşardy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":7,"lesson":"7B","page":56,"section":"vocabulary_bank"}]],["afraid of","/əˈfreɪd əv/","PHR","gorkýan","боящийся","feeling fear about something","She is afraid of flying.","Uçmakdan gorkýar.","A2","Oxford 3000","—","afraid of spiders","New",[{"book":"pre","unit":7,"lesson":"7C","page":58,"section":"vocabulary"}]],["angry with","/ˈæŋɡri wɪð/","PHR","gaharly","злой на","feeling anger towards a person","My mum was angry with me.","Ejem menden gaharly boldy.","A2","Oxford 3000","—","angry with someone","New",[{"book":"pre","unit":7,"lesson":"7C","page":58,"section":"vocabulary"}]],["bad at","/bæd æt/","PHR","erbet","плохой в","not good at something","I am bad at remembering names.","Atlary ýatda saklamakda erbet.","A2","Oxford 3000","—","bad at maths","New",[{"book":"pre","unit":7,"lesson":"7C","page":58,"section":"vocabulary"}]],["famous for","/ˈfeɪməs fə(r)/","PHR","meşhur","известный чем-то","well known because of something","The city is famous for its carpets.","Şäher halyçylygy bilen meşhur.","A2","Oxford 3000","—","famous for food","New",[{"book":"pre","unit":7,"lesson":"7C","page":58,"section":"vocabulary"}]],["full of","/fʊl əv/","PHR","doly","полный","containing a lot of something","The square was full of people.","Meýdança adamdan doludy.","A2","Oxford 3000","—","full of people","New",[{"book":"pre","unit":7,"lesson":"7C","page":58,"section":"vocabulary"}]],["good at","/ɡʊd æt/","PHR","ussat","хороший в","able to do something well","He is good at football.","Futbolda ussat.","A2","Oxford 3000","—","good at languages","New",[{"book":"pre","unit":7,"lesson":"7C","page":58,"section":"vocabulary"}]],["keen on","/kiːn ɒn/","PHR","höwesli","увлекающийся","very interested in something","She is keen on photography.","Surata düşürmäge höwesli.","B1","Oxford 5000","—","keen on music","New",[{"book":"pre","unit":7,"lesson":"7C","page":58,"section":"vocabulary"}]],["married to","/ˈmærid tuː/","PHR","durmuşda","женатый на","having a husband or wife","She is married to a doctor.","Lukman bilen durmuşda.","A2","Oxford 3000","—","married to him","New",[{"book":"pre","unit":7,"lesson":"7C","page":58,"section":"vocabulary"}]],["proud of","/praʊd əv/","PHR","buýsanýan","гордящийся","pleased about something you did","We are proud of our son.","Oglumyz bilen buýsanýarys.","A2","Oxford 3000","—","proud of you","New",[{"book":"pre","unit":7,"lesson":"7C","page":58,"section":"vocabulary"}]],["tired of","/ˈtaɪəd əv/","PHR","ýadan","уставший от","bored with something repeated","I am tired of waiting.","Garaşmakdan ýadadym.","A2","Oxford 3000","—","tired of waiting","New",[{"book":"pre","unit":7,"lesson":"7C","page":58,"section":"vocabulary"}]],["worried about","/ˈwʌrid əˈbaʊt/","PHR","alada","беспокоящийся о","feeling unhappy about possible problems","She is worried about the exam.","Synag barada alada edýär.","A2","Oxford 3000","—","worried about money","New",[{"book":"pre","unit":7,"lesson":"7C","page":58,"section":"vocabulary"}]],["similar to","/ˈsɪmələ tuː/","PHR","meňzeş","похожий на","almost the same as something","Your coat is similar to mine.","Paltoň menkiňe meňzeş.","A2","Oxford 3000","—","similar to mine","New",[{"book":"pre","unit":7,"lesson":"7C","page":58,"section":"vocabulary"}]],["get lost","/ɡet lɒst/","PHR","azmak","заблудиться","to not know where you are","We got lost in the old town.","Köne şäherde azdyk.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":8,"lesson":"8A","page":62,"section":"vocabulary_bank"}]],["get better","/ɡet ˈbetə(r)/","PHR","gowulaşmak","становиться лучше","to improve; to become less ill","Your English is getting better.","Iňlis diliň gowulaşýar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":8,"lesson":"8A","page":62,"section":"vocabulary_bank"}]],["get worse","/ɡet ˈwɜːsə(r)/","PHR","ýaramazlaşmak","ухудшаться","to become less good","The weather got worse in the evening.","Agşam howa ýaramazlaşdy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":8,"lesson":"8A","page":62,"section":"vocabulary_bank"}]],["get ready","/ɡet ˈredi/","PHR","taýýarlanmak","собираться","to prepare yourself","Get ready, we are leaving.","Taýýarlan, gidýäris.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":8,"lesson":"8A","page":62,"section":"vocabulary_bank"}]],["get on well","/ɡet ɒn wel/","PHR","oňuşmak","ладить","to have a good relationship","I get on well with my colleagues.","Işdeşlerim bilen oňuşýaryn.","A2","Oxford 3000","—","get on well with","New",[{"book":"pre","unit":8,"lesson":"8A","page":62,"section":"vocabulary_bank"}]],["get to","/ɡet tuː/","PHR","barmak","добираться до","to arrive at a place","How do I get to the station?","Wokzala nädip barmaly?","A2","Oxford 3000","—","get to work","New",[{"book":"pre","unit":8,"lesson":"8A","page":62,"section":"vocabulary_bank"}]],["get fit","/ˌɡet ˈfɪt/","PHR","forma girmek","прийти в форму","to exercise so your body becomes strong","She swims to get fit.","Forma girmek üçin ýüzýär.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":8,"lesson":"8A","page":62,"section":"vocabulary_bank"}]],["get divorced","/ˌɡet dɪˈvɔːst/","PHR","aýrylyşmak","развестись","to end a marriage","They got divorced last year.","Olar geçen ýyl aýrylyşdylar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":8,"lesson":"8A","page":62,"section":"vocabulary_bank"},{"book":"int","unit":5,"lesson":"5B","page":50,"section":"vocabulary_bank"}]],["get tickets","/ˌɡet ˈtɪkɪts/","PHR","bilet almak","достать билеты","to buy tickets","We got tickets for the concert.","Konsert üçin bilet aldyk.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":8,"lesson":"8A","page":62,"section":"vocabulary_bank"}]],["bring","/brɪŋ/","V","getirmek","приносить","to carry something towards here","Bring your dictionary tomorrow.","Ertir sözlügini getir.","A1","Oxford 3000","—","bring something with you","New",[{"book":"pre","unit":8,"lesson":"8B","page":64,"section":"vocabulary_bank"}]],["wait","/weɪt/","V","garamak","ждать","to stay until something happens","Wait for me at the corner.","Burçda meni gara.","A1","Oxford 3000","—","wait for","New",[{"book":"pre","unit":8,"lesson":"8B","page":64,"section":"vocabulary_bank"}]],["look","/lʊk/","V","seretmek","смотреть (взглянуть)","to direct your eyes at something","Look at this photo.","Şu surata seret.","A1","Oxford 3000","—","look at","New",[{"book":"pre","unit":8,"lesson":"8B","page":64,"section":"vocabulary_bank"}]],["earn","/ɜːn/","V","gazandyrmak","зарабатывать","to get money for work","She earns a good salary.","Ol gowy aýlyk gazanýar.","A2","Oxford 3000","—","earn money","New",[{"book":"pre","unit":8,"lesson":"8B","page":64,"section":"vocabulary_bank"},{"book":"int","unit":2,"lesson":"2A","page":16,"section":"vocabulary_bank"}]],["remind","/rɪˈmaɪnd/","V","ýatlatmak","напоминать","to help someone remember","Remind me to call my mum.","Ejeme jaň etmegi ýatlat.","A2","Oxford 3000","—","remind me","New",[{"book":"pre","unit":8,"lesson":"8B","page":64,"section":"vocabulary_bank"},{"book":"upp","unit":7,"lesson":"7A","section":"vocabulary_bank"},{"book":"intp","unit":9,"lesson":"9A","page":86,"section":"wordbuilding"}]],["rise","/raɪz/","V","galmak","подниматься","to go up by itself","The sun rises in the east.","Gün gündogarda galýar.","A2","Oxford 3000","—","prices rise","New",[{"book":"pre","unit":8,"lesson":"8B","page":64,"section":"vocabulary_bank"},{"book":"upp","unit":7,"lesson":"7A","section":"vocabulary_bank"}]],["lie","/laɪ/","V","ýatmak","лежать","to be in a flat position","The cat lay on the sofa.","Pişik diwanyň üstünde ýatdy.","A2","Oxford 3000","—","lie on the bed","New",[{"book":"pre","unit":8,"lesson":"8B","page":64,"section":"vocabulary_bank"},{"book":"upp","unit":7,"lesson":"7A","section":"vocabulary_bank"}]],["carry","/ˈkæri/","V","götermek, daşamak","нести","to hold and move something with you","She carried a heavy bag.","Agyr torba göterdi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":8,"lesson":"8B","page":64,"section":"vocabulary_bank"}]],["know","/nəʊ/","V","bilmek","знать","to have information in your mind","I know the answer.","Jogaby bilýärin.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":8,"lesson":"8B","page":64,"section":"vocabulary_bank"}]],["angrily","/ˈæŋɡrɪli/","ADV","gaharly","сердито","in an angry way","She closed the door angrily.","Gapyny gaharly ýapdy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":8,"lesson":"8C","page":66,"section":"vocabulary"}]],["hardly","/ˈhɑːdli/","ADV","diýen ýaly hiç","едва, почти не","almost not at all","I hardly know him.","Ony diýen ýaly tanamaýaryn.","A2","Oxford 3000","—","hardly ever","New",[{"book":"pre","unit":8,"lesson":"8C","page":66,"section":"vocabulary"},{"book":"upp","unit":3,"lesson":"3B","section":"vocabulary_bank"}]],["luckily","/ˈlʌkɪli/","ADV","bagtymyza","к счастью","fortunately","Luckily nobody was hurt.","Bagtymyza hiç kim şikes almady.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":8,"lesson":"8C","page":66,"section":"vocabulary"}]],["quietly","/ˈkwaɪətli/","ADV","sessiz","тихо","without noise","She spoke quietly in his ear.","Gulagyna sessiz gepldi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":8,"lesson":"8C","page":66,"section":"vocabulary"}]],["ant","/ænt/","N","garynja","муравей","a very small insect living in large groups","Ants carried a leaf across the path.","Garynjalar ýapragy ýoldan geçirdi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["bee","/biː/","N","ary","пчела","a flying insect that makes honey","A bee landed on the flower.","Ary güle gondy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["beetle","/ˈbiːtl/","N","möjek","жук","an insect with a hard shell","A large black beetle crawled past.","Uly gara möjek emekläp geçdi.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["butterfly","/ˈbʌtəflaɪ/","N","kebelek","бабочка","an insect with large colourful wings","Butterflies flew over the meadow.","Kebeleklar çemeniň üstünde uçdy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["crab","/kræb/","N","ýengç","краб","a sea animal with a shell and ten legs","We found a crab under the rock.","Daşyň astyndan ýengç tapdyk.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"},{"book":"int","unit":1,"lesson":"1A","page":6,"section":"vocabulary_bank"}]],["fly","/flaɪ/","N","siňek","муха","a common flying insect","There is a fly in my soup.","Çorbamda siňek bar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["frog","/frɒɡ/","N","gurbaga","лягушка","a small animal that jumps and lives near water","Frogs were singing by the pond.","Gurbagalar howdanyň ýanynda aýdym aýdýardy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["mosquito","/məˈskiːtəʊ/","N","çybyn","комар","a small insect that bites","Mosquitoes kept me awake all night.","Çybynlar bütin gije uky bermedi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["snake","/sneɪk/","N","ýylan","змея","a long animal with no legs","A snake was crossing the road.","Ýylan ýoldan geçýärdi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["spider","/ˈspaɪdə(r)/","N","möý","паук","an insect-like animal with eight legs","A big spider sat in the corner.","Uly möý burçda oturýardy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["whale","/weɪl/","N","kit","кит","the largest animal in the sea","We saw a whale from the boat.","Gaýykdan kit gördük.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["bat","/bæt/","N","ýarganat","летучая мышь","a small animal that flies at night","Bats sleep in old buildings.","Ýarganatlar köne binalarda uklaýar.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["dolphin","/ˈdɒlfɪn/","N","delfin","дельфин","a clever sea animal","Dolphins followed our boat.","Delfinler gaýygymyzyň yzyndan ýüzdü.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["eagle","/ˈiːɡl/","N","bürgüt","орёл","a large strong bird","An eagle circled above the mountains.","Bürgüt daglaryň üstünde aýlandy.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["owl","/aʊl/","N","baýguş","сова","a bird that is active at night","An owl called in the dark forest.","Garaňky tokaýda baýguş gygyrdy.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["shark","/ʃɑːk/","N","akula","акула","a large dangerous fish","We did not swim because of the sharks.","Akulalar sebäpli ýüzmedik.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["bear","/beə/","N","aýy","медведь","a large heavy wild animal","We saw a bear in the forest.","Tokaýda aýy gördük.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["bird","/bɜːd/","N","guş","птица","an animal with wings and feathers","The birds are singing.","Guşlar aýdym aýdýar.","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["bull","/bʊl/","N","öküz","бык","a male cow","The bull is dangerous.","Öküz howply.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["camel","/ˈkæml/","N","düýe","верблюд","a desert animal with humps","We rode a camel.","Düýä mündik.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["cow","/kaʊ/","N","sygyr","корова","a large farm animal that gives milk","The cow gives us milk.","Sygyr bize süýt berýär.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"},{"book":"intp","unit":5,"lesson":"5B","page":50,"section":"vocabulary_bank"}]],["crocodile","/ˈkrɒkədaɪl/","N","timsah","крокодил","a large reptile with big teeth","The crocodile waited in the river.","Timsah derýada garaşdy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["deer","/dɪə/","N","maral","олень","a wild animal like a small horse with horns","A deer ran across the road.","Maral ýoldan ylgap geçdi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["elephant","/ˈelɪfənt/","N","pil","слон","the largest land animal","The elephant has big ears.","Piliň uly gulaklary bar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["giraffe","/dʒəˈrɑːf/","N","zürafa","жираф","a tall African animal with a long neck","The giraffe eats leaves from trees.","Zürafa agaçlaryň ýapraklaryny iýýär.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["goat","/ɡəʊt/","N","geçi","коза","a farm animal with horns","The goat climbed the hill.","Geçi depä dyrmaşdy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["horse","/hɔːs/","N","at","лошадь","a large animal you can ride","She rides her horse every day.","Her gün atyna münýär.","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["kangaroo","/ˌkæŋɡəˈruː/","N","kenguru","кенгуру","an Australian animal that jumps","The kangaroo carried its baby.","Kenguru çagasyny göterdi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["lion","/ˈlaɪən/","N","arslan","лев","a large wild cat","The lion is the king of animals.","Arslan haýwanlaryň şasy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["mouse","/maʊs/","N","syçan","мышь","a small furry animal","A mouse ran under the table.","Syçan stoluň aşagyndan ylgady.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["pig","/pɪɡ/","N","doňuz","свинья","a farm animal","The pigs are eating.","Doňuzlar iýýär.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["rabbit","/ˈræbɪt/","N","towşan","кролик","a small animal with long ears","The rabbit eats carrots.","Towşan käşir iýýär.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["rat","/ræt/","N","krysa","крыса","like a big mouse","A rat ran along the wall.","Krysa diwaryň boýun ylgady.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["sheep","/ʃiːp/","N","goýun","овца","a farm animal with wool","The sheep are in the field.","Goýunlar meýdanda.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["tiger","/ˈtaɪɡə/","N","ýolbars","тигр","a large wild cat with lines on its body","The tiger hunts at night.","Ýolbars gije awlaýar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["wasp","/wɒsp/","N","eşek arysy","оса","a flying insect that can sting","A wasp is in the kitchen.","Aşhanada eşek arysy bar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["jellyfish","/ˈdʒelifɪʃ/","N","meduza","медуза","a soft sea animal","Do not touch the jellyfish.","Meduza el degirme.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"}]],["scared","/skeəd/","ADJ","gorkan","испуганный","afraid; feeling fear","The little boy was scared of dogs.","Kiçi oglan itlerden gorkýardy.","A2","Oxford 3000","—","scared of","New",[{"book":"pre","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["terrified","/ˈterɪfaɪd/","ADJ","elhenç gorkan","в ужасе","very scared","She is terrified of heights.","Beýiklikden elhenç gorkýar.","B1","Oxford 5000","—","terrified of heights","New",[{"book":"pre","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["horror","/ˈhɒrə(r)/","N","elhençlik","ужас","great fear; a film type about fear","He watched a horror film alone.","Elhençlik filmini ýeke gördi.","A2","Oxford 3000","—","a horror film","New",[{"book":"pre","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["nightmare","/ˈnaɪtmeə(r)/","N","gabus","кошмар","a frightening dream","I had a nightmare last night.","Düýn gije gabus gördüm.","A2","Oxford 3000","—","have a nightmare","New",[{"book":"pre","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["scream","/skriːm/","V","gygyrmak","кричать (от страха)","to make a loud high sound from fear","She screamed when she saw the spider.","Möýi görüp gygyrdy.","A2","Oxford 3000","—","scream in fear","New",[{"book":"pre","unit":9,"lesson":"9B","page":72,"section":"vocabulary"},{"book":"adv","unit":4,"lesson":"4B","section":"vocabulary_bank"}]],["panic","/ˈpænɪk/","N","howp","паника","sudden uncontrollable fear","Don't panic — we will find a way.","Howp etme — ýol taparys.","B1","Oxford 5000","—","don't panic","New",[{"book":"pre","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["shake","/ʃeɪk/","V","titremek","дрожать","to move quickly from fear or cold","His hands were shaking.","Elleri titräp durdy.","A2","Oxford 3000","—","shake with fear","New",[{"book":"pre","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["tremble","/ˈtrembl/","V","gorkudan titremek","трястись","to shake because of fear","Her voice trembled as she spoke.","Gürände sesi titredi.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["nervous","/ˈnɜːvəs/","ADJ","tolgunan","нервничающий","worried and not relaxed","I felt nervous before the exam.","Synagdan öň tolgundym.","A2","Oxford 3000","—","feel nervous","New",[{"book":"pre","unit":9,"lesson":"9B","page":72,"section":"vocabulary"}]],["grow up","/ɡrəʊ ʌp/","PHR","ulalmak","взрослеть","to become an adult","He grew up in a small village.","Kiçi obada ulaldy.","A2","Oxford 3000","—","grow up in","New",[{"book":"pre","unit":9,"lesson":"9C","page":74,"section":"vocabulary"},{"book":"intp","unit":7,"lesson":"7A","page":66,"section":"vocabulary_bank"}]],["marry","/ˈmæri/","V","öýlenmek","жениться","to become husband and wife","They married in the spring.","Ýaz aýynda öýlendiler.","A2","Oxford 3000","—","marry young","New",[{"book":"pre","unit":9,"lesson":"9C","page":74,"section":"vocabulary"}]],["retire","/rɪˈtaɪə(r)/","V","pensiýa çykmak","уходить на пенсию","to stop working because of age","My father retired last year.","Kakam geçen ýyl pensiýa çykdy.","A2","Oxford 3000","—","retire from work","New",[{"book":"pre","unit":9,"lesson":"9C","page":74,"section":"vocabulary"},{"book":"int","unit":8,"lesson":"8A","page":76,"section":"vocabulary_bank"},{"book":"adv","unit":1,"lesson":"1B","section":"vocabulary_bank"}]],["career","/kəˈrɪə(r)/","N","kär durmuşy","карьера","a job or profession over many years","She had a long career in medicine.","Lukmançylykda uzak kär durmuşy boldy.","A2","Oxford 3000","—","a successful career","New",[{"book":"pre","unit":9,"lesson":"9C","page":74,"section":"vocabulary"},{"book":"adv","unit":1,"lesson":"1B","section":"vocabulary_bank"}]],["achievement","/əˈtʃiːvmənt/","N","üstünlik","достижение","something important you succeed in doing","Winning the prize was a great achievement.","Baýragy almak uly üstünlik boldy.","B1","Oxford 5000","—","a great achievement","New",[{"book":"pre","unit":9,"lesson":"9C","page":74,"section":"vocabulary"},{"book":"int","unit":9,"lesson":"9A","page":86,"section":"vocabulary"},{"book":"adv","unit":10,"lesson":"10A","section":"wordbuilding"}]],["invent","/ɪnˈvent/","V","oýlap tapmak","изобретать","to create something for the first time","He invented a new kind of engine.","Täze görnüşli hereketlendiriji oýlap tapdy.","A2","Oxford 3000","—","invent a machine","New",[{"book":"pre","unit":9,"lesson":"9C","page":74,"section":"vocabulary"}]],["discover","/dɪˈskʌvə(r)/","V","üstüni açmak","открывать (находить)","to find something for the first time","Scientists discovered a new planet.","Alymlar täze planetanyň üstüni açdy.","A2","Oxford 3000","—","discover a place","New",[{"book":"pre","unit":9,"lesson":"9C","page":74,"section":"vocabulary"}]],["poet","/ˈpəʊɪt/","N","şahyr","поэт","a person who writes poems","Magtymguly is a great Turkmen poet.","Magtymguly beýik türkmen şahyry.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9C","page":74,"section":"vocabulary"}]],["novelist","/ˈnɒvəlɪst/","N","romançy","романист","a person who writes long stories","The novelist lives in London.","Romançy Londonda ýaşaýar.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":9,"lesson":"9C","page":74,"section":"vocabulary"}]],["painter","/ˈpeɪntə(r)/","N","suratkeş","художник","a person who paints pictures","The painter showed us her work.","Suratkeş bize işlerini görkezdi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":9,"lesson":"9C","page":74,"section":"vocabulary"}]],["athletics","/æθˈletɪks/","N","ýeňil atletika","лёгкая атлетика","sports like running, jumping and throwing","She does athletics at school.","Mekdepde ýeňil atletika bilen meşgullanýar.","A2","Oxford 3000","—","do athletics","New",[{"book":"pre","unit":10,"lesson":"10A","page":78,"section":"vocabulary_bank"}]],["badminton","/ˈbædmɪntən/","N","badminton","бадминтон","a game with rackets and a light object","We play badminton in the park.","Seýilgähde badminton oýnaýarys.","A2","Oxford 3000","—","play badminton","New",[{"book":"pre","unit":10,"lesson":"10A","page":78,"section":"vocabulary_bank"}]],["boxing","/ˈbɒksɪŋ/","N","boks","бокс","a sport where two people fight with gloves","He does boxing twice a week.","Hepdede iki gezek boks bilen meşgullanýar.","A2","Oxford 3000","—","do boxing","New",[{"book":"pre","unit":10,"lesson":"10A","page":78,"section":"vocabulary_bank"}]],["karate","/kəˈrɑːti/","N","karate","карате","a Japanese sport of fighting with hands and feet","My sister has done karate for years.","Uýam ýyllap karate bilen meşgullandy.","A2","Oxford 3000","—","do karate","New",[{"book":"pre","unit":10,"lesson":"10A","page":78,"section":"vocabulary_bank"}]],["rugby","/ˈrʌɡbi/","N","regbi","регби","a team game with an oval ball","They play rugby at university.","Uniwersitetde regbi oýnaýarlar.","A2","Oxford 3000","—","play rugby","New",[{"book":"pre","unit":10,"lesson":"10A","page":78,"section":"vocabulary_bank"}]],["table tennis","/ˈteɪbl tenɪs/","N","stol tennisi","настольный теннис","a game like tennis on a table","We watched a table tennis final.","Stol tennisi finalyna seretdik.","A2","Oxford 3000","—","play table tennis","New",[{"book":"pre","unit":10,"lesson":"10A","page":78,"section":"vocabulary_bank"}]],["volleyball","/ˈvɒlibɔːl/","N","wolleybol","волейбол","a team game over a high net","The girls play volleyball after school.","Gyzlar mekdepden soň wolleybol oýnaýar.","A2","Oxford 3000","—","play volleyball","New",[{"book":"pre","unit":10,"lesson":"10A","page":78,"section":"vocabulary_bank"}]],["climb","/klaɪm/","V","dyrmaşmak","взбираться","to go up something steep","We climbed the hill in the dark.","Tüm garaňkylykda depe dyrmaşdyk.","A2","Oxford 3000","—","climb a mountain","New",[{"book":"pre","unit":10,"lesson":"10A","page":78,"section":"vocabulary_bank"}]],["crawl","/krɔːl/","V","emmeklemek","ползти","to move on hands and knees","The baby crawled across the floor.","Çaga poluň üstünden emmekledi.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":10,"lesson":"10A","page":78,"section":"vocabulary_bank"},{"book":"advp","unit":2,"lesson":"2B","section":"vocabulary_bank"}]],["dive","/daɪv/","V","suwa bökmek","нырять","to jump into water head first","He dived into the pool.","Howuza başy bilen bökdü.","B1","Oxford 5000","—","dive into","New",[{"book":"pre","unit":10,"lesson":"10A","page":78,"section":"vocabulary_bank"}]],["jump","/dʒʌmp/","V","bökmek","прыгать","to push yourself off the ground","The cat jumped onto the table.","Pişik stoluň üstüne bökdü.","A2","Oxford 3000","—","jump high","New",[{"book":"pre","unit":10,"lesson":"10A","page":78,"section":"vocabulary_bank"}]],["slide","/slaɪd/","V","typmak","скользить","to move smoothly over a surface","The car slid on the ice.","Maşyn buzuň üstünden typdy.","B1","Oxford 5000","—","slide across","New",[{"book":"pre","unit":10,"lesson":"10A","page":78,"section":"vocabulary_bank"}]],["throw","/θrəʊ/","V","zyňmak","бросать","to send something through the air","Throw me the ball.","Top maňa zyň.","A2","Oxford 3000","—","throw a ball","New",[{"book":"pre","unit":10,"lesson":"10A","page":78,"section":"vocabulary_bank"},{"book":"int","unit":6,"lesson":"6B","page":60,"section":"vocabulary_bank"}]],["catch","/kætʃ/","V","tutmak","ловить","to take hold of something moving","She caught the ball with one hand.","Topy bir eli bilen tutdy.","A2","Oxford 3000","—","catch a ball","New",[{"book":"pre","unit":10,"lesson":"10A","page":78,"section":"vocabulary_bank"}]],["hit","/hɪt/","V","urmak","ударять, бить","to touch something hard with force","He hit the ball hard.","Ol pökgä gaty urdy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":10,"lesson":"10A","page":78,"section":"vocabulary_bank"},{"book":"upp","unit":6,"lesson":"6B","section":"vocabulary"}]],["kick","/kɪk/","V","depmek","ударять ногой","to hit something with your foot","Kick the ball to me!","Pökgini maňa dep!","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":10,"lesson":"10A","page":78,"section":"vocabulary_bank"},{"book":"int","unit":6,"lesson":"6B","page":60,"section":"vocabulary_bank"}]],["drop off","/drɒp ɒf/","PHR","düşürmek","высаживать","to take someone to a place and leave them","I will drop you off at school.","Seni mekdebe düşürerin.","A2","Oxford 3000","—","drop off at the airport","New",[{"book":"pre","unit":10,"lesson":"10B","page":80,"section":"vocabulary_bank"}]],["pick up","/pɪk ʌp/","PHR","almak","поднимать; забирать","to lift something; to collect someone","Can you pick the children up at six?","Çagalary altyda alyp bilersiňmi?","A2","Oxford 3000","—","pick up from the airport","New",[{"book":"pre","unit":10,"lesson":"10B","page":80,"section":"vocabulary_bank"}]],["put away","/pʊt əˈweɪ/","PHR","ýerine goýmak","убирать на место","to put things where they belong","Put away your clothes.","Eşikleriňi ýerine goý.","A2","Oxford 3000","—","put away the dishes","New",[{"book":"pre","unit":10,"lesson":"10B","page":80,"section":"vocabulary_bank"},{"book":"intp","unit":7,"lesson":"7A","page":66,"section":"vocabulary_bank"}]],["send back","/send bæk/","PHR","yzyna ibermek","отправлять обратно","to return something by post","We sent the shoes back to the shop.","Aýakgaplary dükana yzyna iberdik.","A2","Oxford 3000","—","send back an order","New",[{"book":"pre","unit":10,"lesson":"10B","page":80,"section":"vocabulary_bank"},{"book":"intp","unit":7,"lesson":"7A","page":66,"section":"vocabulary_bank"}]],["take out","/teɪk aʊt/","PHR","çykarmak","выносить","to remove something from a place","He took out the bins.","Zibil gaplaryny çykardy.","A2","Oxford 3000","—","take out the rubbish","New",[{"book":"pre","unit":10,"lesson":"10B","page":80,"section":"vocabulary_bank"},{"book":"intp","unit":7,"lesson":"7A","page":66,"section":"vocabulary_bank"}]],["turn off","/tɜːn ɒf/","PHR","öçürmek","выключать","to stop a machine or light","Turn off the TV and go to bed.","Telewizory öçür-de ýat.","A1","Oxford 3000","—","turn off the lights","New",[{"book":"pre","unit":10,"lesson":"10B","page":80,"section":"vocabulary_bank"},{"book":"intp","unit":5,"lesson":"5A","page":46,"section":"vocabulary_bank"}]],["turn on","/tɜːn ɒn/","PHR","ýakmak","включать","to start a machine or light","Turn on the heating, please.","Ýyladyjyny ýak.","A1","Oxford 3000","—","turn on the TV","New",[{"book":"pre","unit":10,"lesson":"10B","page":80,"section":"vocabulary_bank"},{"book":"intp","unit":5,"lesson":"5A","page":46,"section":"vocabulary_bank"}]],["write down","/raɪt daʊn/","PHR","ýazyp almak","записывать","to record words on paper","Write down the new words.","Täze sözleri ýazyp al.","A2","Oxford 3000","—","write down the answer","New",[{"book":"pre","unit":10,"lesson":"10B","page":80,"section":"vocabulary_bank"}]],["go on","/ɡəʊ ɒn/","PHR","dowam etmek","продолжать","to continue doing something","She went on talking.","Gürleşmegini dowam etdi.","A2","Oxford 3000","—","go on doing","New",[{"book":"pre","unit":10,"lesson":"10B","page":80,"section":"vocabulary_bank"}]],["look round","/lʊk raʊnd/","PHR","aýlanyp görmek","осматривать","to walk around a place to see it","We looked round the museum.","Muzeýi aýlanyp gördük.","A2","Oxford 3000","—","look round a city","New",[{"book":"pre","unit":10,"lesson":"10B","page":80,"section":"vocabulary_bank"},{"book":"intp","unit":7,"lesson":"7A","page":66,"section":"vocabulary_bank"}]],["run out of","/rʌn aʊt əv/","PHR","gutarmak","заканчиваться (о запасах)","to use all of something","We ran out of petrol.","Benzinimiz gutardy.","A2","Oxford 3000","—","run out of time","New",[{"book":"pre","unit":10,"lesson":"10B","page":80,"section":"vocabulary_bank"}]],["find out","/ˌfaɪnd ˈaʊt/","PHR","öwrenmek, anyklamak","выяснить, узнать","to get information about something","I found out the answer online.","Jogaby onlaýn öwrendim.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":10,"lesson":"10B","page":80,"section":"vocabulary_bank"}]],["get out of bed","/ˌɡet aʊt əv ˈbed/","PHR","düşekden turmak","вставать с постели","to leave your bed in the morning","He gets out of bed at seven.","Sagat ýedide düşekden turýar.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":10,"lesson":"10B","page":80,"section":"vocabulary_bank"}]],["go off","/ˌɡəʊ ˈɒf/","PHR","(jaň) çalmak","звенеть, срабатывать","when an alarm makes a noise","My alarm went off at six.","Budilnigim sagat altyda çaldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":10,"lesson":"10B","page":80,"section":"vocabulary_bank"}]],["turn up","/ˌtɜːn ˈʌp/","PHR","peýda bolmak","появляться (часто неожиданно)","to arrive, often late","He turned up an hour late.","Bir sagat giç geldi.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":10,"lesson":"10B","page":80,"section":"vocabulary_bank"},{"book":"intp","unit":5,"lesson":"5A","page":46,"section":"vocabulary_bank"}]],["Dutch","/dʌtʃ/","ADJ","gollandiýaly","голландский","from the Netherlands","The Dutch engineer works here.","Gollandiýaly inžener şu ýerde işleýär.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":10,"lesson":"10C","page":82,"section":"vocabulary"}]],["Greek","/ɡriːk/","ADJ","grek","греческий","from Greece","I love Greek food.","Grek naharyny söýýärin.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":10,"lesson":"10C","page":82,"section":"vocabulary"}]],["Portuguese","/ˌpɔːtʃəˈɡiːz/","ADJ","portugaliýaly","португальский","from Portugal","She speaks Portuguese.","Portugalça gürleýär.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":10,"lesson":"10C","page":82,"section":"vocabulary"}]],["Swedish","/ˈswiːdɪʃ/","ADJ","şwesiýaly","шведский","from Sweden","The Swedish team won.","Şwesiýa topary utdy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":10,"lesson":"10C","page":82,"section":"vocabulary"}]],["Thai","/taɪ/","ADJ","taýlandly","тайский","from Thailand","Thai food is often spicy.","Taýland nahary köplenç ajy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":10,"lesson":"10C","page":82,"section":"vocabulary"}]],["Ukrainian","/juːˈkreɪniən/","ADJ","ukrainaly","украинский","from Ukraine","Our Ukrainian colleague joined us.","Ukrainaly işdeşimiz bize goşuldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":10,"lesson":"10C","page":82,"section":"vocabulary"}]],["Vietnamese","/ˌvjetnəˈmiːz/","ADJ","wýetnamly","вьетнамский","from Vietnam","Vietnamese coffee is very strong.","Wýetnam kofesi gaty güýçli.","B1","Oxford 5000","—","—","New",[{"book":"pre","unit":10,"lesson":"10C","page":82,"section":"vocabulary"}]],["Indian","/ˈɪndiən/","ADJ","hindi","индийский","from India","The Indian restaurant is new.","Hindi restorany täze.","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":10,"lesson":"10C","page":82,"section":"vocabulary"}]],["biology","/baɪˈɒlədʒi/","N","biologiýa","биология","the study of living things","Biology is my favourite subject.","Biologiýa meniň iň söýýän predmetim.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":11,"lesson":"11A","page":86,"section":"vocabulary"},{"book":"upp","unit":10,"lesson":"10A","section":"vocabulary"}]],["chemistry","/ˈkemɪstri/","N","himiýa","химия","the study of substances","We did an experiment in chemistry.","Himiýada tejribe etdik.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":11,"lesson":"11A","page":86,"section":"vocabulary"},{"book":"upp","unit":10,"lesson":"10A","section":"vocabulary"}]],["physics","/ˈfɪzɪks/","N","fizika","физика","the study of energy and matter","Physics was difficult for me.","Fizika maňa kyn boldy.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":11,"lesson":"11A","page":86,"section":"vocabulary"},{"book":"upp","unit":10,"lesson":"10A","section":"vocabulary"}]],["geography","/dʒiˈɒɡrəfi/","N","geografiýa","география","the study of the earth and countries","We studied maps in geography.","Geografiýada kartalary öwrendik.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":11,"lesson":"11A","page":86,"section":"vocabulary"}]],["history","/ˈhɪstri/","N","taryh","история","the study of the past","The history lesson was fascinating.","Taryh sapagy örän gyzykly boldy.","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":11,"lesson":"11A","page":86,"section":"vocabulary"}]],["literature","/ˈlɪtrətʃə(r)/","N","edebiýat","литература","the study of books and poems","We read poems in literature.","Edebiýatda goşgulary okadyk.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":11,"lesson":"11A","page":86,"section":"vocabulary"}]],["maths","/mæθs/","N","matematika","математика","the study of numbers","Maths starts at nine.","Matematika dokuzda başlaýar.","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":11,"lesson":"11A","page":86,"section":"vocabulary"}]],["science","/ˈsaɪəns/","N","ylym","наука","the study of the natural world","Children love science experiments.","Çagalar ylym tejribelerini söýýär.","A2","Oxford 3000","—","—","New",[{"book":"pre","unit":11,"lesson":"11A","page":86,"section":"vocabulary"}]],["art","/ɑːt/","N","surat sapagy","искусство (предмет)","drawing and painting as a subject","We painted landscapes in art.","Surat sapagynda peýzažlary suratlandyrdyk.","A1","Oxford 3000","—","—","New",[{"book":"pre","unit":11,"lesson":"11A","page":86,"section":"vocabulary"}]],["drama","/ˈdrɑːmə/","N","teatr sapagy","драма","acting as