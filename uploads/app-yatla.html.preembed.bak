ok":"beg","unit":4,"lesson":"4A","page":24,"section":"vocabulary"}]],["boy","/bɔɪ/","N","oglan","мальчик","a male child or young man","The boy is ten years old.","Oglan on ýaşynda.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4A","page":24,"section":"vocabulary"},{"book":"ele","unit":10}]],["girl","/ɡɜːl/","N","gyz","девочка","a female child or young woman","The girl is my sister.","Gyz meniň uýam.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4A","page":24,"section":"vocabulary"},{"book":"ele","unit":10}]],["man","/mæn/","N","erkek adam","мужчина","an adult male person (plural: men)","The man is my father.","Erkek adam meniň kakam.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4A","page":24,"section":"vocabulary"},{"book":"ele","unit":10}]],["woman","/ˈwʊmən/","N","aýal","женщина","an adult female person (plural: women)","The woman is a doctor.","Aýal lukman.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4A","page":24,"section":"vocabulary"},{"book":"ele","unit":10}]],["brother","/ˈbrʌðə/","N","dogan (aka, ini)","брат","a boy or man who has the same parents as you","This is my brother, Ryan.","Bu meniň doganym Raýan.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4A","page":24,"section":"vocabulary"},{"book":"ele","unit":4,"lesson":"4A","page":30,"section":"vocabulary_bank"}]],["sister","/ˈsɪstə/","N","uýa, siňil","сестра","a girl or woman who has the same parents as you","Brenda is Ryan's sister.","Brenda Raýanyň uýasy.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4A","page":24,"section":"vocabulary"},{"book":"ele","unit":4,"lesson":"4A","page":30,"section":"vocabulary_bank"}]],["father","/ˈfɑːðə/","N","kaka, ata","отец","your male parent","My father is a teacher.","Kakam mugallym.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4A","page":24,"section":"vocabulary"},{"book":"ele","unit":4,"lesson":"4A","page":30,"section":"vocabulary_bank"}]],["mother","/ˈmʌðə/","N","eje, ene","мать","your female parent","Her mother is a doctor.","Onuň ejesi lukman.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4A","page":24,"section":"vocabulary"},{"book":"ele","unit":4,"lesson":"4A","page":30,"section":"vocabulary_bank"}]],["friend","/frend/","N","dost","друг","a person you like and spend time with","Bob and Rita are friends.","Bob we Rita dostlar.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4A","page":24,"section":"vocabulary"}]],["black","/blæk/","ADJ","gara","чёрный","the darkest colour","He drives a black car.","Ol gara maşyn sürýär.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"}]],["blue","/bluː/","ADJ","gök","синий","the colour of a clear sky","The sky is blue.","Asman gök.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"}]],["brown","/braʊn/","ADJ","goňur","коричневый","the colour of earth or wood","She has brown eyes.","Onuň gözleri goňur.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"}]],["green","/ɡriːn/","ADJ","ýaşyl","зелёный","the colour of grass","The car is green.","Maşyn ýaşyl.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"}]],["orange","/ˈɒrɪndʒ/","ADJ","mämişi","оранжевый","the colour between red and yellow","I like the orange one.","Mämişi bolanyny halaýaryn.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"}]],["white","/waɪt/","ADJ","ak","белый","the colour of snow","The walls are white.","Diwarlar ak.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"}]],["yellow","/ˈjeləʊ/","ADJ","sary","жёлтый","the colour of the sun","She has a yellow bag.","Onuň sary sumkasy bar.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"}]],["red","/red/","ADJ","gyzyl","красный","the colour of blood","Stop at the red light.","Gyzyl çyrada duruň.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"}]],["beautiful","/ˈbjuːtɪfl/","ADJ","owadan","красивый","very pleasing to look at","What a beautiful view!","Nähili owadan görnüş!","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"},{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["dirty","/ˈdɜːti/","ADJ","hapa, kirli","грязный","not clean","My hands are dirty.","Ellerim hapa.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"},{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["easy","/ˈiːzi/","ADJ","aňsat","лёгкий","not difficult","This exercise is easy.","Bu maşk aňsat.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"},{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["difficult","/ˈdɪfɪkəlt/","ADJ","kyn","трудный","not easy","English spelling is difficult.","Iňlis ýazuwy kyn.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"},{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["old","/əʊld/","ADJ","köne, garry","старый","not new, or having lived a long time","This is an old building.","Bu köne bina.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"},{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["new","/njuː/","ADJ","täze","новый","recently made or bought","I have a new phone.","Täze telefonum bar.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"},{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["big","/bɪɡ/","ADJ","uly","большой","large in size","They live in a big flat.","Olar uly öýde ýaşaýar.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"},{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["small","/smɔːl/","ADJ","kiçi","маленький","not big in size","I want a small table.","Kiçi stol isleýärin.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"}]],["hot","/hɒt/","ADJ","yssy, gyzgyn","горячий","having a high temperature","Be careful, the soup is hot.","Ünsli boluň, çorba gyzgyn.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"},{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["cold","/kəʊld/","ADJ","sowuk","холодный","having a low temperature","The water is cold.","Suw sowuk.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"},{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"},{"book":"pre","unit":5,"lesson":"5C","page":42,"section":"vocabulary"}]],["fast","/fɑːst/","ADJ","çalt, tiz","быстрый","moving quickly","That is a fast car.","Ol çalt maşyn.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"},{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"},{"book":"pre","unit":8,"lesson":"8C","page":66,"section":"vocabulary"}]],["slow","/sləʊ/","ADJ","haýal","медленный","not fast","The bus is slow today.","Bu gün awtobus haýal.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"},{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["good","/ɡʊd/","ADJ","gowy, oňat","хороший","of a high standard","This is a good book.","Bu gowy kitap.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"},{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["bad","/bæd/","ADJ","erbet, ýaman","плохой","not good","The weather is bad.","Howa erbet.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"},{"book":"ele","unit":2,"lesson":"2B","page":16,"section":"vocabulary_bank"}]],["great","/ɡreɪt/","ADJ","ajaýyp","отличный","very good","We had a great time.","Ajaýyp wagt geçirdik.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"}]],["terrible","/ˈterəbl/","ADJ","elhenç","ужасный","very bad","The traffic is terrible.","Ýol hereketi elhenç.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"}]],["ugly","/ˈʌɡli/","ADJ","ýakymsyz","некрасивый","not attractive to look at","That is an ugly hat.","Ol ýakymsyz telpek.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"}]],["good-looking","/ˌɡʊd ˈlʊkɪŋ/","ADJ","görmegeý, owadan","красивый, привлекательный","attractive; used for both men and women","The actor is very good-looking.","Aktor gaty görmegeý.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":4,"lesson":"4B","page":26,"section":"vocabulary"},{"book":"pre","unit":1,"lesson":"1B","page":8,"section":"vocabulary_bank"},{"book":"upp","unit":1,"lesson":"1B","section":"vocabulary"}]],["cereal","/ˈsɪəriəl/","N","düýi dänesi, gury ertirlik","хлопья","a breakfast food made from grain, eaten with milk","I have cereal for breakfast.","Ertirlikde gury ertirlik iýýärin.","A1","Oxford 3000","—","a bowl of cereal","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["eggs","/eɡz/","N","ýumurtga","яйца","round white or brown food laid by hens","Two eggs, please.","Iki ýumurtga, haýyş.","A1","Oxford 3000","—","boiled eggs","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["pasta","/ˈpæstə/","N","makaron","паста","an Italian food made from flour and water","We eat pasta on Friday.","Anna güni makaron iýýäris.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["salad","/ˈsæləd/","N","salat","салат","a dish of raw vegetables","A green salad, please.","Ýaşyl salat, haýyş.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["fruit","/fruːt/","N","miwe","фрукты","sweet food that grows on trees or plants","Eat more fruit.","Köpräk miwe iýiň.","A1","Oxford 3000","—","fresh fruit","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"}]],["butter","/ˈbʌtə/","N","ýag","сливочное масло","a soft yellow food made from cream","Bread and butter, please.","Çörek we ýag, haýyş.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["cheese","/tʃiːz/","N","peýnir","сыр","a solid food made from milk","I like cheese on bread.","Çörekde peýniri halaýaryn.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"}]],["chicken","/ˈtʃɪkɪn/","N","towuk","курица","meat from a bird, or the bird itself","We had chicken for dinner.","Agşamlyga towuk iýdik.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"pre","unit":9,"lesson":"9A","page":70,"section":"vocabulary"},{"book":"int","unit":1,"lesson":"1A","page":6,"section":"vocabulary_bank"}]],["meat","/miːt/","N","et","мясо","the flesh of animals eaten as food","He does not eat meat.","Ol et iýmeýär.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["fish","/fɪʃ/","N","balyk","рыба","an animal that lives in water, eaten as food","Fresh fish is good for you.","Täze balyk peýdaly.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["rice","/raɪs/","N","tüwi","рис","small white or brown grains cooked and eaten","Rice with meat, please.","Et bilen tüwi, haýyş.","A1","Oxford 3000","—","a plate of rice","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["potatoes","/pəˈteɪtəʊz/","N","ýeralma","картофель","round brown vegetables that grow underground","I like boiled potatoes.","Gaýnadylan ýeralmany halaýaryn.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["sugar","/ˈʃʊɡə/","N","şeker","сахар","a sweet white substance you put in tea","No sugar for me, thanks.","Maňa şekersiz, sag boluň.","A1","Oxford 3000","—","a spoon of sugar","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["chocolate","/ˈtʃɒklət/","N","şokolad","шоколад","a sweet brown food made from cocoa","I love chocolate.","Şokolady gowy görýärin.","A1","Oxford 3000","—","a bar of chocolate","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["tea","/tiː/","N","çaý","чай","a hot drink made with leaves and water","Would you like some tea?","Çaý isleýärsiňizmi?","A1","Oxford 3000","—","a cup of tea","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["coffee","/ˈkɒfi/","N","kofe","кофе","a hot dark drink made from beans","A cappuccino, please.","Bir kapuçino, haýyş.","A1","Oxford 3000","—","a cup of coffee","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["milk","/mɪlk/","N","süýt","молоко","a white drink that comes from cows","Milk in my tea, please.","Çaýyma süýt, haýyş.","A1","Oxford 3000","—","a glass of milk","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["orange juice","/ˈɒrɪndʒ dʒuːs/","N","pytykal suwy","апельсиновый сок","a drink made from oranges","Orange juice for breakfast.","Ertirlik pytykal suwy.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"}]],["mineral water","/ˈmɪnərəl wɔːtə/","N","mineral suw","минеральная вода","natural water from underground","A bottle of mineral water, please.","Bir çüýşe mineral suw, haýyş.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"}]],["wine","/waɪn/","N","çakyr","вино","an alcoholic drink made from grapes","They ordered red wine.","Gyzyl çakyr sargyt etdiler.","A1","Oxford 3000","—","a glass of wine","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"}]],["beer","/bɪə/","N","piwo","пиво","an alcoholic drink made from grain","Two beers, please.","Iki piwo, haýyş.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"}]],["breakfast","/ˈbrekfəst/","N","ertirlik","завтрак","the first meal of the day","Breakfast is at seven.","Ertirlik sagat ýedide.","A1","Oxford 3000","—","have breakfast","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["lunch","/lʌntʃ/","N","günortanlyk","обед","the meal you eat in the middle of the day","We have lunch at one.","Günortanlyk sagat birde.","A1","Oxford 3000","—","have lunch","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["dinner","/ˈdɪnə/","N","agşamlyk","ужин","the main meal of the day, eaten in the evening","Dinner is ready!","Agşamlyk taýýar!","A1","Oxford 3000","—","have dinner","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":9,"lesson":"9A","page":70,"section":"vocabulary_bank"}]],["eat","/iːt/","V","iýmek","есть","to put food in your mouth and swallow it","I eat breakfast at seven.","Sagat ýedide ertirlik iýýärin.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":3,"lesson":"3A","page":22,"section":"vocabulary_bank"}]],["drink","/drɪŋk/","V","içmek","пить","to swallow liquid","I drink tea every morning.","Her irden çaý içýärin.","A1","Oxford 3000","—","drink water","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"},{"book":"ele","unit":3,"lesson":"3A","page":22,"section":"vocabulary_bank"}]],["have (food)","/hæv/","V","iýmek, içmek","есть, пить","used for eating or drinking something","I had a coffee.","Bir kofe içdim.","A1","Oxford 3000","—","have breakfast","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"}]],["yogurt","/ˈjɒɡət/","N","gatyk","йогурт","a soft sour food made from milk (also spelled yoghurt)","I have yogurt and fruit for breakfast.","Men ertirlikde gatyk we miýe iýýärin.","A1","Oxford 3000","—","—","New",[{"book":"beg","unit":5,"lesson":"5A","page":30,"section":"vocabulary"}]],["live","/lɪv/","V","ýaşamak","жить","to have your home in a place","I live in Ashgabat.","Aşgabatda ýaşaýaryn.","A1","Oxford 3000","—","live in","New",[{"book":"beg","unit":5,"lesson":"5B","page":32,"section":"vocabulary"},{"book":"ele","unit":3,"lesson":"3A","page":22,"section":"vocabulary_bank"},{"book":"intp","unit":7,"lesson":"7B","page":70,"section":"vocabulary"}]],["flat","/flæt/","N","öý, kwartira","квартира","a set of rooms to live in inside a building","They live in a small flat.","Olar kiçi kwartirada ýaşaýar.","A1","Oxford 3000","—","live in a flat","New",[{"book":"beg","unit":5,"lesson":"5B","page":32,"section":"vocabulary"},{"book":"intp","unit":10,"lesson":"10A","page":96,"section":"vocabulary"}]],["cook","/kʊk/","V","nahar bişirmek","готовить","to make food with heat","My father cooks dinner.","Kakam agşamlyk bişirýär.","A1","Oxford 3000","—","cook dinner","New",[{"book":"beg","unit":5,"lesson":"5B","page":32,"section":"vocabulary"},{"book":"ele","unit":3,"lesson":"3A","page":22,"section":"vocabulary_bank"}]],["study","/ˈstʌdi/","V","okamak, öwrenmek","учиться","to spend time learning about a subject","I study English every day.","Her gün iňlis öwrenýärin.","A1","Oxford 3000","—","study English","New",[{"book":"beg","unit":5,"lesson":"5B","page":32,"section":"vocabulary"},{"book":"ele","unit":3,"lesson":"3A","page":22,"section":"vocabulary_bank"},{"book":"pre","unit":8,"lesson":"8B","page":64,"section":"vocabulary_bank"}]],["work (v.)","/wɜːk/","V","işlemek","работать","to do a job","She works in a hotel.","Ol myhmanhanada işleýär.","A1","Oxford 3000","—","work in","New",[{"book":"beg","unit":5,"lesson":"5B","page":32,"section":"vocabulary"}]],["need","/niːd/","V","zerur bolmak","нуждаться","to require something","I need a new phone.","Maňa täze telefon gerek.","A1","Oxford 3000","—","need to","New",[{"book":"beg","unit":5,"lesson":"5B","page":32,"section":"voc