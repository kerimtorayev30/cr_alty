            <b style="flex:1" data-i18n="dark_t">Dark mode</b><span class="val" data-i18n="dark_sub">Eye-friendly study</span>
            <button class="sw" id="darkSw" aria-label="Dark mode"></button></div>
          <div class="mrow"><span class="mico" style="background:var(--orange)"><svg><use href="#i-bell"/></svg></span>
            <b style="flex:1" data-i18n="sound_t">Sound effects</b><span class="val" data-i18n="sound_sub">Correct / wrong / clicks</span>
            <button class="sw on" id="soundSw" aria-label="Sound effects"></button></div>
          <div class="mrow"><span class="mico" style="background:var(--purple)"><svg><use href="#i-bell"/></svg></span>
            <b style="flex:1" data-i18n="notif_t">Study reminders</b><span class="val" data-i18n="notif_sub">Streak &amp; review alerts</span>
            <button class="sw" id="notifSw" aria-label="Study reminders"></button></div>
          <div class="mrow"><span class="mico" style="background:var(--teal)"><svg><use href="#i-cert"/></svg></span><b style="flex:1" data-i18n="cert_t">Certificates</b><span class="val" data-i18n="earned">2 earned</span><span class="chev"><svg><use href="#i-chev"/></svg></span></div>
          <div class="mrow" id="logout"><span class="mico" style="background:var(--red)"><svg><use href="#i-x"/></svg></span><b style="flex:1" data-i18n="logout">Log out</b><span class="chev"><svg><use href="#i-chev"/></svg></span></div>
