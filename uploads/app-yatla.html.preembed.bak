      </div>
      <img class="hero" src="data:image/jpeg;base64," alt="Ýatla mascot">
      <div class="ob-dark">
        <button class="btn btn-p" data-auth="signup" data-i18n="ob_create">Create an Account</button>
        <button class="btn btn-g" data-auth="login" data-i18n="ob_login">Log In</button>
        <div class="divrow"><i></i><span data-i18n="ob_or">or continue with</span><i></i></div>
