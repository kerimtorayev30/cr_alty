son who breaks the law","The criminal was sent to prison.","Jenaýatçy türmä iberildi.","A2","Oxford 3000","—","—","New",[{"book":"int","unit":10,"lesson":"10B","page":100,"section":"vocabulary"}]],["detective","/dɪˈtektɪv/","N","derňewçi","детектив","a police officer who solves crimes","The detective found the clue.","Derňewçi yzy tapdy.","A2","Oxford 3000","—","—","New",[{"book":"int","unit":10,"lesson":"10B","page":100,"section":"vocabulary"}]],["evidence","/ˈevɪdəns/","N","subutnama","улика, доказательство","facts that show something is true","There was no evidence.","Subutnama ýokdy.","B1","Oxford 5000","—","find evidence","New",[{"book":"int","unit":10,"lesson":"10B","page":100,"section":"vocabulary"}]],["guilty","/ˈɡɪlti/","ADJ","günäkär","виновный","responsible for a crime","The jury found him guilty.","Kazyýet ony günäkär tapdy.","A2","Oxford 3000","—","feel guilty","New",[{"book":"int","unit":10,"lesson":"10B","page":100,"section":"vocabulary"}]],["innocent","/ˈɪnəsnt/","ADJ","günäsiz","невинный","not responsible for a crime","She was proved innocent.","Günäsizdigi subut edildi.","A2","Oxford 3000","—","—","New",[{"book":"int","unit":10,"lesson":"10B","page":100,"section":"vocabulary"}]],["judge","/dʒʌdʒ/","N","kazy","судья","the person who decides in court","The judge asked for silence.","Kazy sessizlik sorady.","A2","Oxford 3000","—","—","New",[{"book":"int","unit":10,"lesson":"10B","page":100,"section":"vocabulary"}]],["jury","/ˈdʒʊəri/","N","halk kazylary","присяжные","the people who decide guilt in court","The jury reached a decision.","Halk kazylary karara geldi.","B1","Oxford 5000","—","—","New",[{"book":"int","unit":10,"lesson":"10B","page":100,"section":"vocabulary"}]],["prison","/ˈprɪzn/","N","türme","тюрьма","where criminals are kept","He spent ten years in prison.","Türmede on ýyl geçirdi.","A2","Oxford 3000","—","in prison","New",[{"book":"int","unit":10,"lesson":"10B","page":100,"section":"vocabulary"}]],["sentence","/ˈsentəns/","N","höküm","п